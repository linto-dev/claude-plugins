#!/usr/bin/env -S python3 -I
"""実装計画を進める、決定論的な操作と指揮役。

判断の要らない操作を、文章の指示ではなくここで行う。どのサブコマンドも同じ入力なら同じ結果を出す。

  run                指揮役。次に行うことを決め、ワーカーを claude -p で 1 つずつ動かし、確かめてから次へ進む。途中で切れたワーカーは、同じ会話を続きから再開する
  next               次に行うことを決める（何も変えない）
  verify             ワーカーの後に、コミット・PR の進捗・手元を確かめる（CI を待つのは仕上げの後だけ）
  values             計画の README の「プロンプトに入れる値」の表を読む
  check-requirements 要件定義書（requirements.md）が、計画のスキルと点検の読む形になっているかを確かめる
  check-plan         計画の README と計画書が、スキルと指揮役の読む形になっているかを確かめる
  preflight          手元のチェックアウトを確かめる（ブランチ、origin との差、未コミットの変更、済んだフェーズ）
  pr-create          機能の PR が無ければ、README の「機能の PR の本文」と「PR のタイトル」で WIP: 付きで作る
  pr-check-off       機能の PR の本文の進捗で、目印を含むチェックボックスの行を 1 行だけ [x] にする
  pr-body            仕上げた機能の PR の本文の下書きを出す（README・計画書・コミット・結果ファイルから写す）
  pr-finalize        仕上げた本文を確かめ、タイトルの WIP: を外して PR に書く
  ci                 機能の PR の CI が終わるまで待ち、pass・fail・pending・none のどれかを返す
  previous           フェーズのワーカーが push の前に、前の push の CI を待ち、1 つ前のフェーズの「push の後の確認」を出す
  result             ワーカーの結果ファイル（.runs/<名前>.json）を書く
  stops              うまくいかなかったワーカーの記録（.runs/history.jsonl）を集める
  session            要件定義と計画のスキルが、自分の会話の ID を .runs/sessions.jsonl に書く
  usage              計画の会話ごとの時間・モデル・エフォート・トークンを集め（.runs/usage/ に写す）、手順ごとに出す
  commit-skeleton    コミットメッセージの下書きを出す（フェーズと手順を見分ける行は、ここで書く）
  commit-check       コミットメッセージが決まりどおりかを確かめる

run と usage（--json なし）は人が読む文を出す。commit-skeleton と pr-body は下書きの文を出す。ほかは結果を 1 つの JSON で出す。
終了コードは 0 成功／1 確かめた結果が合わない・止まった・失敗／2 使い方の誤り。
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
from pathlib import Path

# 作業名は「計画名-p<番号>」、ほかの手順の名前は「計画名-decisions」など（英小文字・数字・ハイフン）。
WORK_NAME = r"[a-z0-9]+(?:-[a-z0-9]+)*-p[0-9]+"
NAME = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
# 平易な Conventional Commits の 1 行目。
CONVENTIONAL = re.compile(r"^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: \S")
PROGRESS_LINE_OF_DECISIONS = "決定と学びの記録"
DO_NOT_MERGE = "まだマージしない"
ATTRIBUTION = "🤖 Generated with [Claude Code](https://claude.com/claude-code)"

# ワーカーの種類 → (スキル, 名前の後ろ, プロンプトに渡すもの)。phase の名前は作業名そのもの。
WORKERS = {
    "phase": ("implementing-plan-phase", None, "phase_file"),
    "merge-main": ("merging-main-into-feature", "merge-main", "plan_dir"),
    "decisions": ("recording-plan-decisions", "decisions", "plan_dir"),
    "finalize": ("finalizing-feature-pr", "finalize", "plan_dir"),
}
SKILLS = {skill for skill, _, _ in WORKERS.values()}


def plugin_name() -> str | None:
    """このスクリプトを入れたプラグインの名前（bin/ → プラグインの根）。
    プラグインのスキルは /<プラグイン>:<スキル> で呼ぶ。プラグインの外（~/.claude/skills/ など）に置いたときは None。"""
    try:
        manifest = Path(__file__).resolve().parents[1] / ".claude-plugin" / "plugin.json"
        return json.loads(manifest.read_text(encoding="utf-8")).get("name") or None
    except (IndexError, OSError, ValueError):
        return None


PLUGIN = plugin_name()
# プラグインの根。ワーカーに --plugin-dir で渡し、指揮役と同じ版のスキルで動かす。
PLUGIN_ROOT = Path(__file__).resolve().parents[1] if PLUGIN else None


def skill_command(skill: str) -> str:
    return f"/{PLUGIN}:{skill}" if PLUGIN else f"/{skill}"

# CI を待つ時間。ワーカーは Claude Code の Bash ツールの上限（600 秒）に収める。過ぎたら pending を返し、呼び直してもらう。
CI_TIMEOUT_SECONDS = 540
# 指揮役（run）は Bash ツールの外で動くので、長く待ってよい。待つのは仕上げの後だけ。
# フェーズ・main の取り込み・決定と学びの記録は push の後に CI を待たない。前の push の CI は、次のフェーズが
# 自分の push の前に確かめる（previous）。CI は同じ PR への次の push で取り消される（concurrency の cancel-in-progress）ので、
# 確かめるのは push の後ではなく前にする。
RUN_CI_TIMEOUT_SECONDS = 3600
# 計画書の「完了の条件」のうち、push の後にしか確かめられないものに、ワーカーがコミットメッセージで付ける印。
POST_PUSH_MARK = "（push の後に確かめる）"
# push の直後は、GitHub がチェックを作るまで「no checks reported」と返す。ふつうは 1 分以内に現れる。
CI_APPEAR_GRACE_SECONDS = 180
# gh pr checks を読み直す間隔。GitHub の API の利用枠を食いすぎない長さ。
CI_POLL_SECONDS = 20
# 同じ手順がこの回数続けてうまくいかなかったら、run は --retry が無い限り次を起動しない。
MAX_FAILURES = 2
# ワーカーは誰もいないところで動く。API に届かないときや利用上限のときは、Claude Code 自身に待たせる。
# 既定の再試行は 10 回（約 3 分）。ある機能のフェーズ（2026-11-07）は、DNS が引けない 3 分でそれを使い切って終わった。
# watchdog があると、429・529 は戻るまで、利用上限は戻る時刻まで待ち、ほかの一時的な失敗は 300 回（約 3 時間）まで試す。
# https://code.claude.com/docs/en/errors#tune-retry-behavior
WORKER_ENV = {"CLAUDE_CODE_RETRY_WATCHDOG": "1"}
# それでも途中で切れたワーカーの会話は、続きから再開する。1 回の run で自動で再開する回数と、その前に置く間。
AUTO_RESUMES = 2
RESUME_PAUSE_SECONDS = 60
# 再開した会話（claude -p --resume）では、スキルの frontmatter のフックが登録されない（2026-11-07 に 2.1.319 で確かめた）。
# 決まりを守らせるフックは、指揮役が --settings で渡す。
GUARD = Path(os.environ.get("SHIPSTACK_GUARD") or Path(__file__).resolve().parents[1] / "scripts" / "guard.sh")
GUARD_ROLES = {"phase": "implement", "merge-main": "merge-main", "decisions": "decisions", "finalize": "finalize"}
# ワーカーの起動の確かめ。system/init を読んだところ（モデルを呼ぶ前）で行い、合わなければワーカーを止める。
# - auto mode が使えないと、Claude Code は Manual で始める。--permission-prompts none と組むと、書き込みがすべて拒否されたまま
#   1 手順を使い切るので、init の permissionMode を確かめる（https://code.claude.com/docs/en/permission-modes ）
# - プラグインが読み込めないと、/<プラグイン>:<スキル> が展開されない。init の plugins を確かめる
#   （https://code.claude.com/docs/en/headless#fail-ci-when-a-plugin-or-mcp-server-doesnt-load ）
# - --bare（公式は将来 -p の既定にすると予告している）や、管理者の設定の disableAllHooks では --settings のフックが動かず、
#   決まりのフック（guard.sh）が効かない。--settings に SessionStart のフックを置き、init より前に流れるその hook_response で、
#   フックが動いたことを確かめる（2026-11-18 に 2.1.327 で、--bare では流れないことを確かめた）
HOOKS_ON = "shipstack-hooks-on"
# 権限のモードの別名（init の permissionMode は別名を使わない）。
PERMISSION_MODE_ALIASES = {"manual": "default"}
# ワーカーのエフォート。指揮役が --effort で渡す（設定ファイルの modelSettings・effortLevel より強く、
# CLAUDE_CODE_EFFORT_LEVEL とスキルの frontmatter の effort より弱い）。Opus 5.5 の既定は medium で、公式は「medium から始め、
# 自分の課題で水準を比べ、xhigh と max は差を測った仕事にだけ使う」とする。medium は範囲のはっきりした新しい機能の実装、
# high は既存のコードを直すような、検証が要り端が出やすい仕事（2026-11-18 に読んだ）。
# https://code.claude.com/docs/en/model-config#adjust-effort-level
# https://platform.claude.com/docs/en/build-with-claude/effort
EFFORT_LEVELS = ("low", "medium", "high", "xhigh", "max")
EFFORT_COLUMN = "エフォート"
# フェーズはフェーズ表の「エフォート」の値。列の無い前の版の計画は high（新しいものを足すだけか、既存を変えるかが分からない）。
WORKER_EFFORTS = {"phase": "high", "merge-main": "medium", "decisions": "medium", "finalize": "medium"}
RESUME_PROMPT = """（指揮役より）この会話の前の実行は、途中で切れました（{reason}）。
手元の未コミットの変更とコミットは、この会話でここまでにした作業です。最初の指示「{prompt}」のスキルの手順を、切れたところから最後（結果ファイルを書いて報告する）まで進めてください。
- 始める前の確認（shipstack preflight）はやり直さない（未コミットの変更があるので止まる）
- まず git status と git log -1 で手元を確かめ、済んだ手順は繰り返さない
- 切れたときに動いていたコマンド（テストや検査）は、もう一度実行して結果を確かめる"""


class Failure(Exception):
    """確かめた結果が合わない、または外のコマンドが失敗した（終了コード 1）。"""

    def __init__(self, message: str, **extra):
        super().__init__(message)
        self.extra = extra


# ---------------------------------------------------------------- 外のコマンド


def repo_root() -> str:
    """git と gh を動かすリポジトリ。run はワーカーに SHIPSTACK_REPO を渡すので、ワーカーがどこに cd しても同じになる。"""
    env = os.environ.get("SHIPSTACK_REPO")
    if env:
        return env
    proc = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if proc.returncode == 0 and proc.stdout.strip():
        return proc.stdout.strip()
    raise Failure("git のリポジトリの中で実行します（計画のディレクトリが Git の外なら、リポジトリのルートに cd してから）")


def run(args: list[str], cwd: str | None = None, check: bool = True, input_text: str | None = None) -> subprocess.CompletedProcess:
    if cwd is None and args and args[0] in ("git", "gh"):
        cwd = repo_root()
    proc = subprocess.run(args, cwd=cwd, input=input_text, capture_output=True, text=True)
    if check and proc.returncode != 0:
        raise Failure(f"{' '.join(args[:3])} が失敗しました: {proc.stderr.strip() or proc.stdout.strip()}")
    return proc


def git(*args: str, cwd: str | None = None, check: bool = True) -> str:
    return run(["git", *args], cwd=cwd, check=check).stdout.strip()


def git_ok(*args: str, cwd: str | None = None) -> bool:
    return run(["git", *args], cwd=cwd, check=False).returncode == 0


def base_branch() -> str:
    ref = git("symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD", check=False)
    return ref.removeprefix("origin/") if ref else "main"


def gh_json(args: list[str]) -> object:
    proc = run(["gh", *args])
    return json.loads(proc.stdout)


# ---------------------------------------------------------------- Markdown


HEADING = re.compile(r"^(#{1,6})[ \t]+(.*?)[ \t]*#*[ \t]*$")
FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")


def fence_marks(lines: list[str]) -> list[str | None]:
    """各行が、コードブロックの外（None）・開き（"open"）・中（"in"）・閉じ（"close"）のどれか。

    CommonMark のとおり、閉じるのは開きと同じ文字で、同じ長さ以上の、後ろに文字の無い囲みだけ。
    ````markdown の中の ``` は閉じにならないので、中の bash の「# コメント」を見出しと取り違えない。
    """
    marks: list[str | None] = []
    opening: str | None = None
    for line in lines:
        match = FENCE.match(line)
        if opening is None:
            if match and not (match.group(1)[0] == "`" and "`" in match.group(2)):
                opening = match.group(1)
                marks.append("open")
            else:
                marks.append(None)
        elif match and match.group(1)[0] == opening[0] and len(match.group(1)) >= len(opening) and not match.group(2).strip():
            opening = None
            marks.append("close")
        else:
            marks.append("in")
    return marks


def heading_title(text: str) -> str:
    """見出しの文字列から、先頭の番号（「2.」「3-4.」など）を除く。"""
    return re.sub(r"^[0-9][0-9.\-]*[ \t]*", "", text).strip()


def find_section(lines: list[str], title: str) -> list[str] | None:
    """見出しが title の節の本文（次の同じか上の階層の見出しの前まで）。コードブロックの中の # は見出しとみなさない。"""
    level = None
    body: list[str] = []
    for line, mark in zip(lines, fence_marks(lines)):
        match = HEADING.match(line) if mark is None else None
        if level is not None:
            if match and len(match.group(1)) <= level:
                break
            body.append(line)
        elif match and heading_title(match.group(2)) == title:
            level = len(match.group(1))
    return body if level is not None else None


def unfence(lines: list[str]) -> list[str]:
    """節の中にコードブロックがちょうど 1 つあれば、その中身だけを返す（前後の説明の文と、外側の囲みを外す）。"""
    marks = fence_marks(lines)
    opens = [i for i, m in enumerate(marks) if m == "open"]
    closes = [i for i, m in enumerate(marks) if m == "close"]
    if len(opens) == 1 and len(closes) == 1:
        return lines[opens[0] + 1:closes[0]]
    return lines


def table_rows(lines: list[str]) -> list[list[str]]:
    """Markdown の表の行を、エスケープしていない | で切ったセルの並びにする。"""
    rows = []
    for line in lines:
        stripped = line.strip()
        if not stripped.startswith("|"):
            continue
        cells = [c.replace("\\|", "|").strip() for c in re.split(r"(?<!\\)\|", stripped.strip("|"))]
        if all(re.fullmatch(r":?-+:?", c) for c in cells if c):
            continue  # 区切りの行
        rows.append(cells)
    return rows


def bullets(lines: list[str] | None) -> list[str]:
    """箇条書き（- と番号付き）の項目の文。「なし」だけなら空。"""
    items = []
    for line in lines or []:
        match = re.match(r"^\s*(?:[-*+]|[0-9]+\.)\s+(?:\[[ xX]\]\s+)?(.*\S)\s*$", line)
        if match:
            items.append(match.group(1))
    return [] if [i.strip("。") for i in items] == ["なし"] else items


def read_lines(path: Path) -> list[str]:
    try:
        return path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError as error:
        raise Failure(f"{path} がありません") from error


# ---------------------------------------------------------------- 計画

# 「プロンプトに入れる値」の任意の欄。run がワーカーに --settings の許可ルールとして渡す。auto mode の分類器は、
# 計画に文章で書いた「許可するコマンド」を利用者の許可として読まないため（2026-11-05 に確かめた）。
ALLOW_RULES = "許可するコマンドのルール"
# 要件定義書。要件定義のスキル（defining-requirements）が計画のディレクトリに書き、計画のスキルが読む。計画書ではない。
REQUIREMENTS_FILE = "requirements.md"
NOT_PHASE_FILES = ("README.md", REQUIREMENTS_FILE)


def narrow_rule(rule: str) -> bool:
    """1 つのコマンドに絞った許可ルールか。MCP の道具は名前だけでよい。"""
    match = re.fullmatch(r"([A-Za-z][\w-]*)(?:\((.+)\))?", rule)
    if not match:
        return False
    tool, content = match.groups()
    if content is None:
        return tool.startswith("mcp__")
    if tool in ("Bash", "PowerShell"):
        # `*` はサブコマンドの後に置く（`Bash(gh *)` は gh pr merge まで通す）。`*` が無ければ 1 つのコマンドそのもの。
        return bool(content.split()) and ("*" not in content or len(content.split("*", 1)[0].split()) >= 2)
    return content.strip() not in ("*", "**")


class Plan:
    def __init__(self, plan_dir: str):
        self.dir = Path(plan_dir).expanduser().resolve()
        self.readme = self.dir / "README.md"
        self.lines = read_lines(self.readme)
        self.values = self._read_values()
        self.name = self.values.get("計画名") or self.dir.name
        self.runs = self.dir / ".runs"

    def _read_values(self) -> dict[str, str | None]:
        section = find_section(self.lines, "プロンプトに入れる値")
        if section is None:
            raise Failure(f"{self.readme} に「プロンプトに入れる値」の節がありません（計画のプロンプトが作る）")
        values: dict[str, str | None] = {}
        for cells in table_rows(section):
            key = re.search(r"\{\{(.+?)\}\}", cells[0]) if cells else None
            if not key:
                continue
            value = "|".join(cells[1:]).strip()
            code = re.fullmatch(r"`([^`]*)`", value)
            if code:
                value = code.group(1)
            values[key.group(1).strip()] = None if value.startswith("なし") else value
        return values

    @property
    def allow_rules(self) -> list[str]:
        """「許可するコマンドのルール」の欄にある Claude Code の許可ルール。欄が無いか「なし」なら空。

        値はコードの書式（`…`）で 1 つずつ書く。広すぎるルール（道具の名前だけ、`Bash(*)`、サブコマンドより前に
        `*` があるもの）は、auto mode 以外のモードでは何でも通してしまうので受け付けない。
        """
        raw = (self.values.get(ALLOW_RULES) or "").strip()
        if not raw:
            return []
        rules = [r.strip() for r in re.findall(r"`([^`]+)`", raw) or [raw] if r.strip()]
        broad = [r for r in rules if not narrow_rule(r)]
        if broad:
            raise Failure(f"「{ALLOW_RULES}」に広すぎるか読めないルールがあります: " + "、".join(broad)
                          + "。1 つのコマンドに絞り、`*` はサブコマンドの後に置きます（例: `Bash(gh pr edit * --add-label preview)`）",
                          broad=broad)
        return rules

    def require(self, *keys: str) -> None:
        missing = [k for k in keys if k not in self.values]
        if missing:
            raise Failure("「プロンプトに入れる値」の表に無い欄があります: " + "、".join(missing), missing=missing)

    @property
    def feature(self) -> str:
        self.require("機能ブランチ")
        branch = self.values["機能ブランチ"]
        if not branch:
            raise Failure("「機能ブランチ」が「なし」になっています")
        return branch

    @property
    def pr_title(self) -> str:
        self.require("PR のタイトル")
        title = re.sub(r"^WIP:\s*", "", (self.values["PR のタイトル"] or "").strip())
        if not CONVENTIONAL.match(title):
            raise Failure(f"「PR のタイトル」は平易な Conventional Commits にします（例: feat(widget): 回答の待ち時間を短くする）: {title}")
        return title

    def phase_names(self) -> list[str]:
        """フェーズ表（README の表の行）に書かれた作業名を、書かれた順に。この順に 1 つずつ実装する。"""
        names: list[str] = []
        for cells in table_rows(self.lines):
            for cell in cells:
                for name in re.findall(rf"(?<![a-z0-9-])({WORK_NAME})(?![a-z0-9-])", cell):
                    if name not in names:
                        names.append(name)
        return names

    def phase_efforts(self) -> dict[str, str] | None:
        """フェーズ表の「エフォート」の列（作業名 → 書いた値）。列の無い前の版の計画は None。"""
        rows = table_rows(find_section(self.lines, "フェーズ表") or [])
        if not rows or EFFORT_COLUMN not in rows[0]:
            return None
        column = rows[0].index(EFFORT_COLUMN)
        efforts: dict[str, str] = {}
        for cells in rows[1:]:
            names = re.findall(rf"(?<![a-z0-9-])({WORK_NAME})(?![a-z0-9-])", " ".join(cells))
            if names:
                efforts[names[0]] = (cells[column] if column < len(cells) else "").strip("` ").lower()
        return efforts

    def phase_file(self, name: str) -> Path:
        for path in sorted(self.dir.glob("*.md")):
            if path.name in NOT_PHASE_FILES:
                continue
            if PhasePlan.work_name_of("\n".join(read_lines(path))) == name:
                return path
        raise Failure(f"作業名 {name} の計画書が {self.dir} にありません（計画書の冒頭に「作業名: `{name}`」と書く）")

    def phases(self) -> list["PhasePlan"]:
        return [PhasePlan(str(self.phase_file(n))) for n in self.phase_names()]

    def prerequisites(self) -> list[str]:
        return bullets(find_section(self.lines, "開始前に人がすること"))

    def pr_body_lines(self) -> list[str]:
        body = find_section(self.lines, "機能の PR の本文")
        if not body or not "".join(body).strip():
            raise Failure(f"{self.readme} に「機能の PR の本文」の節がありません（計画のプロンプトが作る）")
        return unfence(body)


class PhasePlan:
    def __init__(self, path: str):
        self.path = Path(path).expanduser().resolve()
        self.lines = read_lines(self.path)
        name = self.work_name_of("\n".join(self.lines))
        if not name:
            raise Failure(f"{self.path} の冒頭に作業名（<計画名>-p<番号>）が見つかりません")
        self.name = name

    @staticmethod
    def work_name_of(text: str) -> str | None:
        match = re.search(rf"作業名\**\s*[:：]\s*\**\s*`?({WORK_NAME})`?", text)
        return match.group(1) if match else None

    def copied(self, title: str) -> list[str]:
        section = find_section(self.lines, title)
        if section is None:
            raise Failure(f"{self.path} に「{title}」の節がありません")
        return [line.rstrip() for line in section if line.strip()]


def phases_in_commits(rev_range: str) -> list[str]:
    """コミットの本文の「フェーズ」で始まる行に書かれた作業名。"""
    log = git("log", "--format=%B", rev_range, check=False)
    found: list[str] = []
    for line in log.splitlines():
        if line.startswith("フェーズ"):
            for name in re.findall(WORK_NAME, line):
                if name not in found:
                    found.append(name)
    return found


# ---------------------------------------------------------------- check-plan（計画の形）

# 「プロンプトに入れる値」の欄。ワーカーのスキルが values --require で読む欄に、計画の置き場所を足したもの
# （試験が、各スキルの --require と食い違っていないことを確かめる）。許可するコマンドのルールは任意。
VALUE_KEYS = ("計画の置き場所", "計画名", "機能ブランチ", "PR のタイトル", "インストール", "静的解析", "テスト",
              "テストの範囲", "UI の方針", "PR の決まり", "ADR のディレクトリ", "許可するコマンド")
VALUE_KEYS_REQUIRED = ("計画名", "機能ブランチ", "PR のタイトル", "静的解析", "テスト")
# E2E の流し方。仕上げのワーカーが最後のプレビュー（か手元）に流し、変わった記録をコミットする。前に書いた計画が
# 止まらないように、無くても problems にはしない（無ければ「なし」と読む）。
E2E_KEY = "E2E"
README_SECTIONS = ("フェーズ表", "開始前に人がすること", "プロンプトに入れる値", "決めたこと", "機能の PR の本文")
PR_BODY_SECTIONS = ("なぜ", "進捗", "機能の完了の条件", "マージの後に行うこと", "変えてはいけないこと", "対象外", "マージの方法")
# 計画書の節。「変えてはいけないこと」と「対象外」は、仕上げが機能の PR の本文に集める（無ければ「なし」と書く）。
PHASE_SECTIONS = ("完了の条件", "変えてはいけないこと", "対象外", "変更するファイル")
DECISION_COLUMNS = ("決定", "比べた案と採らなかった理由", "選んだ理由", "根拠と出典", "関係するフェーズ")
# 実装が一意にならない言葉。人に聞かないワーカーが、その場で決めることになる。
VAGUE = re.compile(r"TBD|TODO|未定|要検討|適切に|適宜|よしなに|エッジケースを(?:処理|考慮)")
# push の後にしか確かめられない条件の目印。完了の条件にあると、commit-check の [ ] を許さない決まりとぶつかる。
AFTER_PUSH = re.compile(r"プレビュー|push の後|本番|デプロイ|(?<![A-Za-z])CI(?![A-Za-z])")
# 要件定義書の節（defining-requirements の references/requirements-format.md）。任意の節（外部との連携、移行と既存データ）は見ない。
REQUIREMENTS_SECTIONS = ("目的", "材料", "範囲", "用語", "振る舞い", "完了の条件", "品質特性", "権限とデータ", "決めたこと",
                         "計画に任せること")
SCOPE_SECTIONS = ("やること", "やらないこと", "後に回すこと")
REQUIREMENT_DECISION_COLUMNS = ("決定", "比べた案と採らなかった理由", "選んだ理由", "根拠と出典")
# 雛形の置き換える場所（<計画名> など）の残り。日本語を含む <…> だけを見る（HTML のタグと取り違えない）。
PLACEHOLDER = re.compile(r"<[^<>\n]*[ぁ-んァ-ヶ一-龠][^<>\n]*>")
INLINE_CODE = re.compile(r"`[^`\n]*`")
# セキュリティの段階（セキュリティの指針 2 章の A・B・C）。
SECURITY_LEVEL = re.compile(r"段階[^\n]*?(?<![A-Za-z])[ABC](?![A-Za-z])")
# Claude がコマンドやブラウザでできる作業の目印。「開始前に人がすること」に書くと、人が要らない作業を待つ。
CLAUDE_CAN_DO = re.compile(r"ラベル|(?<![A-Za-z])gh(?![A-Za-z])|試験データ|テストデータ|シード|seed|設定ファイル")
# ただし、資格情報の入力が要る作業は人にしかできない（gh auth login など）。
HUMAN_ONLY = re.compile(r"ログイン|auth login|資格情報|秘密の値|パスワード")
TEMPLATE_FIELD = re.compile(r"\{\{[^{}]+\}\}")


def prose_lines(lines: list[str]) -> list[tuple[int, str]]:
    """コードブロックの外の行を、1 から数えた行番号と一緒に。"""
    return [(i, line) for i, (line, mark) in enumerate(zip(lines, fence_marks(lines)), 1) if mark is None]


def section_lines(lines: list[str], title: str) -> set[int]:
    """見出しが title の節の本文の行番号（1 から数える）。"""
    numbers: set[int] = set()
    level = None
    for i, (line, mark) in enumerate(zip(lines, fence_marks(lines)), 1):
        match = HEADING.match(line) if mark is None else None
        if level is not None:
            if match and len(match.group(1)) <= level:
                break
            numbers.add(i)
        elif match and heading_title(match.group(2)) == title:
            level = len(match.group(1))
    return numbers


def empty_cell(cell: str) -> bool:
    return cell.strip() in ("", "-", "—", "ー", "なし")


def check_values(plan: Plan, problems: list[str], warnings: list[str]) -> None:
    where = "README.md「プロンプトに入れる値」"
    missing = [k for k in VALUE_KEYS if k not in plan.values]
    if missing:
        problems.append(f"{where}: 欄がありません: " + "、".join(missing) + "（無い値は「なし」と書く）")
    for key in VALUE_KEYS_REQUIRED:
        if key in plan.values and not plan.values[key]:
            problems.append(f"{where}: 「{key}」は「なし」にできません")
    name = plan.values.get("計画名")
    if name and not NAME.match(name):
        problems.append(f"{where}: 「計画名」は英小文字・数字・ハイフンだけにします: {name}")
    if name and name != plan.dir.name:
        warnings.append(f"{where}: 「計画名」（{name}）が計画のディレクトリの名前（{plan.dir.name}）と違います")
    branch = plan.values.get("機能ブランチ")
    if name and branch and branch != f"feature/{name}":
        warnings.append(f"{where}: 「機能ブランチ」は feature/{name} にします（今は {branch}）")
    reads = ([lambda: plan.pr_title] if "PR のタイトル" in plan.values else []) + [lambda: plan.allow_rules]
    for read in reads:
        try:
            read()
        except Failure as error:
            problems.append(f"{where}: {error}")
    if E2E_KEY not in plan.values:
        warnings.append(f"{where}: 「{E2E_KEY}」の欄がありません。仕上げのワーカーは E2E を流しません（E2E が無いリポジトリなら「なし」と書く）")
    if plan.values.get("許可するコマンド") and not plan.values.get(ALLOW_RULES):
        warnings.append(f"{where}: 「許可するコマンド」があるのに「{ALLOW_RULES}」がありません。auto mode の分類器は文章の許可を"
                        "読まないので、外部に書き込むコマンド（PR のラベルなど）は拒否されえます")


def check_decisions(plan: Plan, warnings: list[str], assumptions: list[str]) -> None:
    check_decision_table(find_section(plan.lines, "決めたこと") or [], "README.md「決めたこと」", DECISION_COLUMNS, warnings, assumptions)


def check_decision_table(section: list[str], where: str, expected: tuple[str, ...], warnings: list[str],
                         assumptions: list[str]) -> None:
    """「決めたこと」の表（計画の README と要件定義書）。根拠が見立ての決定を assumptions に並べる。"""
    rows = table_rows(section)
    if not rows:
        if not bullets(section) and "なし" not in "".join(section):
            warnings.append(f"{where}: 表がありません（案を比べて決めたことが無ければ「なし」と書く）")
        return
    header = rows[0]
    columns = {title: header.index(title) for title in expected if title in header}
    lacking = [t for t in expected if t not in columns]
    if lacking:
        warnings.append(f"{where}: 表に列がありません: " + "、".join(lacking))
    number = header.index("#") if "#" in header else None
    for i, cells in enumerate(rows[1:], 1):
        label = f"#{cells[number]}" if number is not None and number < len(cells) else f"{i} 行目"
        cell = {title: cells[index] if index < len(cells) else "" for title, index in columns.items()}
        for title in ("比べた案と採らなかった理由", "選んだ理由", "根拠と出典"):
            if title in cell and empty_cell(cell[title]):
                warnings.append(f"{where} {label}: 「{title}」が空です")
        reason = cell.get("選んだ理由", "")
        if reason and not empty_cell(reason) and "技術" not in reason and "業務" not in reason:
            warnings.append(f"{where} {label}: 「選んだ理由」に技術と業務の理由がありません")
        if "見立て" in cell.get("根拠と出典", ""):
            assumptions.append(f"{label} {cell.get('決定', '')[:80]}")


def check_pr_body(plan: Plan, names: list[str], problems: list[str], warnings: list[str]) -> None:
    where = "README.md「機能の PR の本文」"
    try:
        body = plan.pr_body_lines()
    except Failure as error:
        problems.append(str(error))
        return
    raw = find_section(plan.lines, "機能の PR の本文") or []
    if fence_marks(raw).count("open") > 1:
        warnings.append(f"{where}: コードブロックが 2 つ以上あるので、節の全体（前後の説明の文も）が PR の本文になります。"
                        "本文を 1 つのブロックで囲み、中のコードブロックはそれより長い囲み（````）の内側に置きます")
    if DO_NOT_MERGE not in "\n".join(body):
        problems.append(f"{where}: 先頭の注意に「{DO_NOT_MERGE}」がありません（指揮役がこの文で、仕上げ前の PR を見分ける）")
    for title in PR_BODY_SECTIONS:
        if find_section(body, title) is None:
            problems.append(f"{where}: 節「{title}」がありません")
    progress = find_section(body, "進捗") or []
    boxes = [line for line in body if CHECKBOX.match(line)]
    for marker in [*names, PROGRESS_LINE_OF_DECISIONS]:
        hits = [line for line in boxes if marker_in(line, marker)]
        if len(hits) != 1:
            problems.append(f"{where}: 「{marker}」を含むチェックボックスの行が {len(hits)} 行あります（進捗にちょうど 1 行。"
                            "pr-check-off がこの行にチェックを入れる）")
    stray = [line.strip() for line in boxes if line not in progress]
    if stray:
        problems.append(f"{where}: チェックボックスは「進捗」だけに使います（PR の一覧の n of m tasks を進捗にするため）: "
                        + " / ".join(stray[:3]))
    order = [n for line in progress for n in names if marker_in(line, n)]
    if order and order != [n for n in names if n in order]:
        warnings.append(f"{where}: 「進捗」の並びがフェーズ表の順と違います")
    if not bullets(find_section(body, "機能の完了の条件")):
        warnings.append(f"{where}: 「機能の完了の条件」に箇条書きがありません")
    # 「マージの後に行うこと」は PR の本文にそのまま写るので、マージの前の作業が混ざると、人が順番を取り違える。
    for item in bullets(find_section(body, "マージの後に行うこと")):
        if "マージの前" in item:
            warnings.append(f"{where}: 「マージの後に行うこと」に、マージの前の作業が入っています（マージの前の確認は、"
                            f"計画書の「push の後の確認」か仕上げが受け持つ）: {item[:80]}")


def check_phase(path: Path, problems: list[str], warnings: list[str]) -> None:
    lines = read_lines(path)
    for title in PHASE_SECTIONS:
        section = find_section(lines, title)
        if section is None:
            problems.append(f"{path.name}: 節「{title}」がありません")
        elif title != "変更するファイル" and not "".join(section).strip():
            problems.append(f"{path.name}: 節「{title}」が空です（コミットメッセージに写す。無ければ「なし」と書く）")
    conditions = section_lines(lines, "完了の条件")
    boxes = [(i, lines[i - 1]) for i in sorted(conditions) if CHECKBOX.match(lines[i - 1])]
    if find_section(lines, "完了の条件") is not None and not boxes:
        problems.append(f"{path.name}「完了の条件」: チェックボックス（- [ ] …）がありません")
    for i, line in boxes:
        if CHECKBOX.match(line).group(2) in "xX":
            warnings.append(f"{path.name}:{i}: 完了の条件にチェックが入っています（計画では [ ] のままにする）")
        if AFTER_PUSH.search(line):
            warnings.append(f"{path.name}:{i}: push の後にしか確かめられない条件に見えます（「push の後の確認」に移す）: {line.strip()[:100]}")


def check_words(path: Path, lines: list[str], skip: set[int], known: set[str], warnings: list[str]) -> None:
    """実装が一意にならない言葉と、値の表に無い {{欄}}（計画のプロンプトの {{目的}} など）。表にある欄はワーカーが値で読む。"""
    for i, line in prose_lines(lines):
        if i in skip:
            continue
        vague = VAGUE.search(line)
        if vague:
            warnings.append(f"{path.name}:{i}: 実装が一意にならない言葉「{vague.group(0)}」: {line.strip()[:100]}")
        for field in TEMPLATE_FIELD.findall(line):
            if field[2:-2].strip() not in known:
                warnings.append(f"{path.name}:{i}: 値の表に無い欄 {field} が残っています")


def check_efforts(plan: Plan, names: list[str], problems: list[str], warnings: list[str]) -> None:
    where = "README.md「フェーズ表」"
    efforts = plan.phase_efforts()
    if efforts is None:
        if names:
            warnings.append(f"{where}: 「{EFFORT_COLUMN}」の列がありません。フェーズのワーカーはすべて {WORKER_EFFORTS['phase']} で動きます"
                            "（フェーズごとに medium か high を書く）")
        return
    for name in names:
        value = efforts.get(name, "")
        if value not in EFFORT_LEVELS:
            problems.append(f"{where}: {name} の「{EFFORT_COLUMN}」は {'・'.join(EFFORT_LEVELS)} のどれかにします（今は「{value}」）")
        elif value not in ("medium", "high"):
            warnings.append(f"{where}: {name} の「{EFFORT_COLUMN}」が {value} です。medium か high から始め、外すのは同じフェーズを"
                            "流し比べて差を確かめたときだけにします（根拠を「決めたこと」に書く）")


def check_plan(plan: Plan) -> dict:
    """計画の README と計画書が、スキルと指揮役の読む形になっているか。人の判断の要ることは見ない。"""
    problems: list[str] = []
    warnings: list[str] = []
    assumptions: list[str] = []
    for title in README_SECTIONS:
        if find_section(plan.lines, title) is None:
            problems.append(f"README.md: 節「{title}」がありません")
    check_values(plan, problems, warnings)

    table = table_rows(find_section(plan.lines, "フェーズ表") or [])
    names: list[str] = []
    for cells in table:
        for cell in cells:
            for name in re.findall(rf"(?<![a-z0-9-])({WORK_NAME})(?![a-z0-9-])", cell):
                if name not in names:
                    names.append(name)
    if not names:
        problems.append("README.md「フェーズ表」: 作業名（<計画名>-p<番号>）がありません")
    elif names != plan.phase_names():
        problems.append("README.md: 「フェーズ表」より前の表に作業名があり、実装の順がずれます: " + "、".join(plan.phase_names()))
    expected = [f"{plan.name}-p{i}" for i in range(1, len(names) + 1)]
    if names and names != expected:
        problems.append(f"README.md「フェーズ表」: 作業名は上から {expected[0]}、{expected[1] if len(expected) > 1 else '…'} … と"
                        "1 から順に付けます: " + "、".join(names))
    check_efforts(plan, names, problems, warnings)

    files: dict[str, list[Path]] = {}
    for path in sorted(plan.dir.glob("*.md")):
        if path.name in NOT_PHASE_FILES:
            continue
        name = PhasePlan.work_name_of("\n".join(read_lines(path)))
        if name is None:
            warnings.append(f"{path.name}: 作業名が無いので、計画書として読みません")
            continue
        files.setdefault(name, []).append(path)
        if name not in names:
            warnings.append(f"{path.name}: 作業名 {name} がフェーズ表にありません")
    for name in names:
        found = files.get(name, [])
        if not found:
            problems.append(f"{name}: 計画書がありません（冒頭に「作業名: `{name}`」と書いた .md を置く）")
        elif len(found) > 1:
            problems.append(f"{name}: 計画書が {len(found)} つあります: " + "、".join(p.name for p in found))
        else:
            check_phase(found[0], problems, warnings)

    for item in plan.prerequisites():
        if CLAUDE_CAN_DO.search(item) and not HUMAN_ONLY.search(item):
            warnings.append(f"README.md「開始前に人がすること」: Claude がコマンドやブラウザでできる作業に見えます"
                            f"（そのフェーズの手順に入れる）: {item[:100]}")
    check_decisions(plan, warnings, assumptions)
    check_pr_body(plan, names, problems, warnings)
    check_requirements_coverage(plan, problems, warnings)
    known = {*VALUE_KEYS, ALLOW_RULES, *plan.values}
    check_words(plan.readme, plan.lines, section_lines(plan.lines, "プロンプトに入れる値"), known, warnings)
    for name in names:
        for path in files.get(name, [])[:1]:
            check_words(path, read_lines(path), set(), known, warnings)
    return {"ok": not problems, "plan_dir": str(plan.dir), "phases": names, "problems": problems, "warnings": warnings,
            "assumptions": assumptions}


def cmd_check_plan(args) -> dict:
    return check_plan(Plan(args.plan_dir))


# ---------------------------------------------------------------- check-requirements（要件定義書の形）


def same_sentence(text: str) -> str:
    """文を比べるための形。空白、強調の記号、文末の句点を除く。"""
    return re.sub(r"\s+", "", text).replace("**", "").rstrip("。")


def requirement_conditions(lines: list[str]) -> list[str]:
    """要件定義書の「完了の条件」の項目の文。"""
    return bullets(find_section(lines, "完了の条件"))


def check_requirements_coverage(plan: Plan, problems: list[str], warnings: list[str]) -> None:
    """要件定義書の完了の条件が、機能の PR の本文に同じ文で入っているか（計画が要件を取りこぼしていないか）。

    マージの前に確かめられない条件は「マージの後に行うこと」に入れてよい。要件定義書の無い計画（要件定義のスキルより前に
    書いた計画）は、動かせるように warnings にとどめる。
    """
    path = plan.dir / REQUIREMENTS_FILE
    if not path.exists():
        warnings.append(f"{REQUIREMENTS_FILE} がありません（要件定義のスキル defining-requirements が書き、計画のスキルがそれを読む）")
        return
    try:
        body = plan.pr_body_lines()
    except Failure:
        return  # check_pr_body が problems に出している
    targets = [same_sentence(item) for title in ("機能の完了の条件", "マージの後に行うこと")
               for item in bullets(find_section(body, title))]
    for condition in requirement_conditions(read_lines(path)):
        if not any(same_sentence(condition) in target for target in targets):
            problems.append(f"README.md「機能の PR の本文」: 要件定義書の完了の条件が、「機能の完了の条件」（マージの前に確かめられない"
                            f"ものは「マージの後に行うこと」）に同じ文でありません: {condition[:100]}")


def check_requirements(plan_dir: str) -> dict:
    """要件定義書が、計画のスキルと点検の読む形になっているか。推測が要るかどうかの中身は点検のスキルが見る。"""
    directory = Path(plan_dir).expanduser().resolve()
    path = directory / REQUIREMENTS_FILE
    lines = read_lines(path)
    where = REQUIREMENTS_FILE
    problems: list[str] = []
    warnings: list[str] = []
    assumptions: list[str] = []

    if not NAME.match(directory.name):
        problems.append(f"計画のディレクトリの名前（計画名）は英小文字・数字・ハイフンだけにします: {directory.name}")
    titles = [m.group(2) for line, mark in zip(lines, fence_marks(lines))
              if mark is None and (m := HEADING.match(line)) and len(m.group(1)) == 1]
    if not titles:
        problems.append(f"{where}: タイトルの見出し（# <計画名>：<1 行の要約>）がありません")
    elif not re.match(rf"{re.escape(directory.name)}\s*[:：]", titles[0]):
        warnings.append(f"{where}: タイトルが「# {directory.name}：<1 行の要約>」の形ではありません: {titles[0][:60]}")

    for title in REQUIREMENTS_SECTIONS:
        section = find_section(lines, title)
        if section is None:
            problems.append(f"{where}: 節「{title}」がありません")
        elif not "".join(section).strip():
            problems.append(f"{where}: 節「{title}」が空です（無ければ「なし」と書く）")
    scope = find_section(lines, "範囲")
    if scope is not None:
        for title in SCOPE_SECTIONS:
            section = find_section(scope, title)
            if section is None:
                problems.append(f"{where}「範囲」: 「{title}」の見出しがありません")
            elif not "".join(section).strip():
                problems.append(f"{where}「範囲」: 「{title}」が空です（無ければ「なし」と書く）")
        todo = find_section(scope, "やること") or []
        if "".join(todo).strip() and not bullets(todo):
            warnings.append(f"{where}「範囲」: 「やること」に箇条書きがありません")

    conditions = requirement_conditions(lines)
    if find_section(lines, "完了の条件") is not None and not conditions:
        problems.append(f"{where}「完了の条件」: 箇条書きがありません（計画が機能の PR の本文に同じ文で写す）")
    rights = find_section(lines, "権限とデータ")
    if rights and "".join(rights).strip() and not SECURITY_LEVEL.search("\n".join(rights)):
        warnings.append(f"{where}「権限とデータ」: セキュリティの段階（A・B・C）がありません")
    decisions = find_section(lines, "決めたこと")
    if decisions is not None:
        check_decision_table(decisions, f"{where}「決めたこと」", REQUIREMENT_DECISION_COLUMNS, warnings, assumptions)

    for i, line in prose_lines(lines):
        vague = VAGUE.search(line)
        if vague:
            warnings.append(f"{where}:{i}: 一意にならない言葉「{vague.group(0)}」: {line.strip()[:100]}")
        # コードの書式の中の <…>（`node app.js <名前>` など）は書き方の例なので見ない。雛形の残りはコードの書式の外にある。
        for field in TEMPLATE_FIELD.findall(line) + PLACEHOLDER.findall(INLINE_CODE.sub("", line)):
            warnings.append(f"{where}:{i}: 置き換える場所 {field} が残っています")
    return {"ok": not problems, "plan_dir": str(directory), "requirements": str(path), "conditions": conditions,
            "problems": problems, "warnings": warnings, "assumptions": assumptions}


def cmd_check_requirements(args) -> dict:
    return check_requirements(args.plan_dir)


# ---------------------------------------------------------------- 状態と次に行うこと


def find_pr(feature: str, base: str) -> dict | None:
    """機能の PR。開いているものを優先し、無ければマージ済み、閉じたものの順。"""
    prs = gh_json(["pr", "list", "--head", feature, "--base", base, "--state", "all",
                   "--json", "number,url,title,state,body", "--limit", "20"])
    for state in ("OPEN", "MERGED", "CLOSED"):
        for pr in prs:
            if pr.get("state") == state:
                return pr
    return None


def checked_line(body: str, marker: str) -> bool:
    return any(CHECKBOX.match(line.rstrip("\r")) and CHECKBOX.match(line.rstrip("\r")).group(2) in "xX"
               and marker_in(line, marker) for line in body.split("\n"))


def collect_state(plan: Plan, fetch: bool = True) -> dict:
    if fetch:
        git("fetch", "origin")
    base = base_branch()
    feature = plan.feature
    out: dict = {"base": base, "feature_branch": feature, "branch_exists": False, "merged_into_base": False,
                 "base_ahead": False, "commits": [], "phases_done": [], "decisions_done": False, "pr": None}
    if not git_ok("rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{base}"):
        raise Failure(f"origin/{base} がありません")
    out["pr"] = find_pr(feature, base)
    if not git_ok("rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{feature}"):
        return out
    out["branch_exists"] = True
    for sha in git("rev-list", "--reverse", f"origin/{base}..origin/{feature}").split():
        body = git("log", "-1", "--format=%B", sha)
        parents = git("log", "-1", "--format=%P", sha).split()
        phases = sorted({n for line in body.splitlines() if line.startswith("フェーズ") for n in re.findall(WORK_NAME, line)})
        steps = sorted({n for line in body.splitlines() if line.startswith("手順")
                        for n in re.findall(r"[a-z0-9]+(?:-[a-z0-9]+)*-decisions", line)})
        out["commits"].append({"commit": sha[:7], "subject": body.splitlines()[0] if body else "",
                               "merge": len(parents) > 1, "phases": phases, "steps": steps})
    # マージ済みかは「機能ブランチの先端が main から辿れる」だけでは決めない。main から作ったばかりの機能ブランチも
    # 辿れるので取り違える。マージコミットでマージしたなら、先端は main の first-parent の列の上に無い。
    tip = git("rev-parse", f"origin/{feature}")
    if git_ok("merge-base", "--is-ancestor", f"origin/{feature}", f"origin/{base}"):
        out["merged_into_base"] = tip not in git("rev-list", "--first-parent", f"origin/{base}").split()
    if not out["merged_into_base"]:
        out["base_ahead"] = not git_ok("merge-base", "--is-ancestor", f"origin/{base}", f"origin/{feature}")
    done = [n for c in out["commits"] for n in c["phases"]]
    out["phases_done"] = [n for n in plan.phase_names() if n in done]
    steps = [s for c in out["commits"] for s in c["steps"]]
    pr_body = (out["pr"] or {}).get("body") or ""
    out["decisions_done"] = f"{plan.name}-decisions" in steps or checked_line(pr_body, PROGRESS_LINE_OF_DECISIONS)
    return out


def worker_step(plan: Plan, kind: str, name: str | None = None) -> dict:
    skill, suffix, target_kind = WORKERS[kind]
    name = name or f"{plan.name}-{suffix}"
    target = str(plan.phase_file(name)) if target_kind == "phase_file" else str(plan.dir)
    return {"action": "worker", "kind": kind, "name": name, "skill": skill, "prompt": f"{skill_command(skill)} {target}",
            "effort": worker_effort(plan, kind, name)}


def worker_effort(plan: Plan, kind: str, name: str) -> str:
    """指揮役がワーカーに --effort で渡す値。フェーズはフェーズ表の値、ほかは手順ごとに決まった値。"""
    if kind == "phase":
        written = (plan.phase_efforts() or {}).get(name)
        if written in EFFORT_LEVELS:
            return written
    return WORKER_EFFORTS[kind]


def effort_override() -> str | None:
    """CLAUDE_CODE_EFFORT_LEVEL は --effort より強い。付いていれば、どのワーカーもその値で動く。"""
    return (os.environ.get("CLAUDE_CODE_EFFORT_LEVEL") or "").strip() or None


def decide(plan: Plan, state: dict) -> dict:
    """状態から次に行うことを 1 つ決める。上から順に見て、最初に当たったものを行う。"""
    pr = state["pr"]
    if state["merged_into_base"] or (pr and pr["state"] == "MERGED"):
        return {"action": "complete", "reason": "機能の PR はマージ済みです"}
    if pr and pr["state"] == "CLOSED" and not state["branch_exists"]:
        return {"action": "stop", "reason": f"機能の PR #{pr['number']} が閉じられています"}
    if not state["branch_exists"]:
        return {"action": "create-branch", "reason": f"origin に {plan.feature} がまだありません。origin/{state['base']} から作ります"}
    if pr and pr["state"] == "CLOSED":
        return {"action": "stop", "reason": f"機能の PR #{pr['number']} が閉じられています。開き直すか、計画を見直します"}
    if state["base_ahead"]:
        return worker_step(plan, "merge-main")
    names = plan.phase_names()
    if not names:
        raise Failure("計画の README のフェーズ表に作業名が見つかりません")
    for name in names:
        if name not in state["phases_done"]:
            return worker_step(plan, "phase", name)
    if pr is None:
        return {"action": "stop", "reason": "全フェーズのコミットがあるのに、機能の PR がありません"}
    finalized = not pr["title"].startswith("WIP:") and DO_NOT_MERGE not in (pr.get("body") or "")
    # 仕上げは決定と学びの記録の後にしか動かない。仕上げた本文には進捗の節が無いので、「なし」の記録は本文から消える。
    if finalized:
        return {"action": "complete", "reason": "仕上げ済みです。PR の本文の手順で確かめてから、マージコミットでマージします"}
    if not state["decisions_done"]:
        return worker_step(plan, "decisions")
    return worker_step(plan, "finalize")


def cmd_next(args) -> dict:
    plan = Plan(args.plan_dir)
    state = collect_state(plan)
    step = decide(plan, state)
    summary = {k: state[k] for k in ("base", "feature_branch", "branch_exists", "merged_into_base", "base_ahead",
                                       "phases_done", "decisions_done")}
    summary["pr"] = {k: state["pr"][k] for k in ("number", "url", "title", "state")} if state["pr"] else None
    summary["phases_missing"] = [n for n in plan.phase_names() if n not in state["phases_done"]]
    return {"ok": True, "next": step, "state": summary}


# ---------------------------------------------------------------- verify


def worktree_problems(plan: Plan) -> list[str]:
    feature = plan.feature
    problems = []
    branch = git("symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    if branch != feature:
        problems.append(f"手元のブランチが {branch or '（切り離された HEAD）'} です（{feature} のはず）")
    if git_ok("rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{feature}") and \
            git("rev-parse", "HEAD") != git("rev-parse", f"origin/{feature}"):
        problems.append(f"手元の HEAD が origin/{feature} と違います（push していないコミットか、取り込んでいないコミットがある）")
    dirty = [line for line in git("status", "--porcelain").splitlines() if line]
    if dirty:
        problems.append(f"未コミットの変更が {len(dirty)} 件あります: " + "、".join(dirty[:5]))
    return problems


def read_result(plan: Plan, name: str, since: float | None) -> dict | None:
    path = plan.runs / f"{name}.json"
    if not path.exists() or (since is not None and path.stat().st_mtime < since):
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def verify_step(plan: Plan, step: dict, since: float | None = None, ci_timeout: int = RUN_CI_TIMEOUT_SECONDS) -> dict:
    name, kind = step["name"], step["kind"]
    result = read_result(plan, name, since)
    if result is None:
        return {"ok": False, "stopped": False, "result": None,
                "problems": [f"ワーカーが結果ファイル（.runs/{name}.json）を書いていません"]}
    if result.get("status") == "stopped":
        return {"ok": False, "stopped": True, "result": result, "problems": [result.get("stopped_reason") or "理由の書かれていない停止"]}
    state = collect_state(plan)
    problems = worktree_problems(plan)
    pr = state["pr"]
    if kind == "phase":
        if name not in state["phases_done"]:
            problems.append(f"origin/{plan.feature} に「フェーズ: {name}」のコミットがありません")
        if not pr or pr["state"] != "OPEN":
            problems.append("開いている機能の PR がありません")
        elif not checked_line(pr["body"], name):
            problems.append(f"機能の PR の進捗で {name} の行にチェックがありません")
    elif kind == "merge-main":
        if state["base_ahead"]:
            problems.append(f"origin/{state['base']} に、まだ取り込んでいないコミットがあります")
    elif kind == "decisions":
        if not state["decisions_done"]:
            problems.append(f"「手順: {plan.name}-decisions」のコミットも、PR の進捗の「{PROGRESS_LINE_OF_DECISIONS}」のチェックもありません")
    elif kind == "finalize":
        if not pr or pr["state"] != "OPEN":
            problems.append("開いている機能の PR がありません")
        else:
            if pr["title"] != plan.pr_title:
                problems.append(f"PR のタイトルが「{pr['title']}」です（「{plan.pr_title}」のはず）")
            if DO_NOT_MERGE in (pr.get("body") or ""):
                problems.append(f"PR の本文に「{DO_NOT_MERGE}」が残っています")
    ci = None
    # CI を待つのは仕上げの後だけ。ほかの手順の push の CI は、次のフェーズか仕上げが確かめて直す。
    if not problems and state["pr"] and kind == "finalize":
        ci = wait_ci(plan.feature, timeout=ci_timeout)
        if ci["ci"] in ("fail", "pending"):
            problems.append(f"CI が {ci['ci']} です: " + "、".join(f"{c['name']}={c['bucket']}" for c in ci.get("checks", [])))
    return {"ok": not problems, "stopped": False, "result": result, "problems": problems, "ci": ci and ci["ci"]}


def cmd_verify(args) -> dict:
    plan = Plan(args.plan_dir)
    kind = args.kind
    step = worker_step(plan, kind, args.name if kind == "phase" else None)
    out = verify_step(plan, step, ci_timeout=args.ci_timeout)
    return {**out, "step": step}


# ---------------------------------------------------------------- values・preflight


def cmd_values(args) -> dict:
    plan = Plan(args.plan_dir)
    if args.require:
        plan.require(*args.require)
    return {"ok": True, "plan_dir": str(plan.dir), "readme": str(plan.readme), "plan_name": plan.name, "values": plan.values}


def cmd_preflight(args) -> dict:
    plan = Plan(args.plan_dir)
    feature = plan.feature
    git("fetch", "origin")
    base = base_branch()
    branch = git("symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    dirty = [line for line in git("status", "--porcelain").splitlines() if line]
    problems: list[str] = []
    out: dict = {"branch": branch or None, "feature_branch": feature, "base": base, "dirty": dirty}
    if branch != feature:
        problems.append(f"今のブランチが {branch or '（切り離された HEAD）'} です。{feature} に切り替えてから動かします")
    if not git_ok("rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{feature}"):
        problems.append(f"origin に {feature} がありません")
    else:
        behind, ahead = git("rev-list", "--left-right", "--count", f"origin/{feature}...HEAD").split()
        out.update(ahead=int(ahead), behind=int(behind))
        if int(ahead) or int(behind):
            problems.append(f"手元が origin/{feature} と違います（{ahead} 進み、{behind} 遅れ）")
    if dirty:
        problems.append(f"未コミットの変更が {len(dirty)} 件あります（ほかの作業が混ざるので触りません）")
    if args.require_phases_done:
        names = plan.phase_names()
        done = phases_in_commits(f"origin/{base}..HEAD")
        missing = [n for n in names if n not in done]
        out["phases"] = {"all": names, "done": [n for n in names if n in done], "missing": missing}
        if not names:
            problems.append("計画の README のフェーズ表に作業名が見つかりません")
        if missing:
            problems.append("まだコミットが無いフェーズがあります: " + "、".join(missing))
    out["problems"] = problems
    out["ok"] = not problems
    return out


# ---------------------------------------------------------------- PR


CHECKBOX = re.compile(r"^(\s*[-*+]\s+\[)([ xX])(\]\s.*)$")


def with_attribution(text: str) -> str:
    text = text.strip() + "\n"
    return text if ATTRIBUTION in text else f"{text}\n{ATTRIBUTION}\n"


def gh_body_file(text: str) -> str:
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False, encoding="utf-8") as f:
        f.write(text)
        return f.name


def cmd_pr_create(args) -> dict:
    plan = Plan(args.plan_dir)
    feature = plan.feature
    base = base_branch()
    existing = find_pr(feature, base)
    if existing and existing["state"] == "OPEN":
        return {"ok": True, "created": False, "pr": existing["url"], "title": existing["title"]}
    title = f"WIP: {plan.pr_title}"
    body_file = gh_body_file(with_attribution("\n".join(plan.pr_body_lines())))
    try:
        url = run(["gh", "pr", "create", "--base", base, "--head", feature, "--title", title, "--body-file", body_file]).stdout.strip()
    finally:
        os.unlink(body_file)
    return {"ok": True, "created": True, "pr": url.splitlines()[-1] if url else None, "title": title}


def marker_in(line: str, marker: str) -> bool:
    if re.fullmatch(WORK_NAME, marker):
        # demo-p1 が demo-p10 に当たらないように、前後が作業名の文字でないことを見る。
        return re.search(rf"(?<![a-z0-9-]){re.escape(marker)}(?![a-z0-9-])", line) is not None
    return marker in line


def check_off(body: str, marker: str, note: str) -> tuple[str, str, str]:
    """目印を含むチェックボックスの行を 1 行だけ [x] にし、行末に（note）を足す。ほかの行は変えない。"""
    lines = body.split("\n")
    hits = [i for i, line in enumerate(lines) if CHECKBOX.match(line.rstrip("\r")) and marker_in(line, marker)]
    if len(hits) != 1:
        raise Failure(
            f"機能の PR の本文の進捗に「{marker}」を含むチェックボックスの行が {len(hits)} 行あります（ちょうど 1 行のはず）",
            lines=[lines[i] for i in hits],
        )
    i = hits[0]
    raw = lines[i]
    cr = "\r" if raw.endswith("\r") else ""
    line = raw.rstrip("\r")
    match = CHECKBOX.match(line)
    assert match
    new = f"{match.group(1)}x{match.group(3)}"
    if f"（{note}）" not in new:
        new = f"{new.rstrip()}（{note}）"
    lines[i] = new + cr
    return "\n".join(lines), raw, lines[i]


def normalized(text: str) -> str:
    return text.replace("\r\n", "\n").rstrip("\n")


def edit_pr(number: int, body: str, title: str | None = None) -> None:
    body_file = gh_body_file(body)
    try:
        cmd = ["gh", "pr", "edit", str(number), "--body-file", body_file]
        if title:
            cmd += ["--title", title]
        run(cmd)
    finally:
        os.unlink(body_file)
    reread = gh_json(["pr", "view", str(number), "--json", "body,title"])
    if normalized(reread["body"]) != normalized(body) or (title and reread["title"] != title):
        raise Failure("書き戻した PR が、書いたものと違います。ほかの誰かが同時に変えたかもしれません")


def cmd_pr_check_off(args) -> dict:
    plan = Plan(args.plan_dir)
    pr = gh_json(["pr", "view", plan.feature, "--json", "number,url,body,state"])
    if pr["state"] != "OPEN":
        raise Failure(f"機能の PR #{pr['number']} は {pr['state']} です")
    new_body, before, after = check_off(pr["body"], args.marker, args.note)
    result = {"ok": True, "pr": pr["url"], "line_before": before.rstrip("\r"), "line_after": after.rstrip("\r")}
    if new_body == pr["body"]:
        return {**result, "changed": False}
    edit_pr(pr["number"], new_body)
    return {**result, "changed": True}


# 仕上げた本文の下書きの、置き換える場所。pr-finalize は 1 つでも残っていれば止める。
PR_PLACEHOLDERS = {
    "why": "<機能が解く問題を 1〜2 文で>",
    "evidence": "<各項目の後ろに「 — 」と満たした根拠（実行したコマンドと結果）を書き、満たしたものを [x] にする。満たさないものは [ ] のまま理由を書く>",
    "verified": "<実行したコマンドと結果、観察できる結果>",
    "order": "<順番に依存がある作業（消す前に外す、など）は、その順に並べ直す。コマンドはそのまま貼れる形にする>",
}
PR_REQUIRED = ("なぜ", "完了の条件", "変えてはいけないこと", "対象外", "確認したこと", "ADR と残さなかった決定", "マージの前に行う確認", "マージの後に行うこと", "マージの方法")
MERGE_METHOD = "マージコミットでマージする（squash しない）。main にフェーズごとのコミットが残り、機能全体を 1 回の revert で戻せる。"


def decisions_blocks(plan: Plan) -> tuple[list[str], list[str]]:
    base = base_branch()
    for sha in git("rev-list", f"origin/{base}..HEAD", check=False).split():
        lines = git("log", "-1", "--format=%B", sha).splitlines()
        if any(line.startswith(f"手順: {plan.name}-decisions") for line in lines):
            return block_after(lines, "残したもの") or [], block_after(lines, "残さなかった決定") or []
    return [], []


def dedup(items: list[str]) -> list[str]:
    seen, out = set(), []
    for item in items:
        if item not in seen:
            seen.add(item)
            out.append(item)
    return out


def pr_body_skeleton(plan: Plan) -> tuple[str, list[str]]:
    body = plan.pr_body_lines()
    why = [line for line in (find_section(body, "なぜ") or []) if line.strip()]
    conditions = bullets(find_section(body, "機能の完了の条件") or find_section(body, "機能の PR で確かめること"))
    keep = bullets(find_section(body, "変えてはいけないこと"))
    scope = bullets(find_section(body, "対象外"))
    after = bullets(find_section(body, "マージの後に行うこと"))
    phases = plan.phases()
    for p in phases:
        keep += bullets(find_section(p.lines, "変えてはいけないこと"))
        scope += bullets(find_section(p.lines, "対象外"))
    manual: list[str] = []
    for name in [p.name for p in phases] + [f"{plan.name}-merge-main", f"{plan.name}-decisions"]:
        result = read_result(plan, name, None)
        manual += (result or {}).get("manual_steps") or []
    kept, not_kept = decisions_blocks(plan)
    if not kept and not not_kept:
        # 何も残さなかったときはコミットが無いので、結果ファイルに書いた「残さなかった決定」を写す。
        not_kept = [f"- {item}" for item in (read_result(plan, f"{plan.name}-decisions", None) or {}).get("not_kept") or []]
    method = [line for line in (find_section(body, "マージの方法") or []) if line.strip()] or [MERGE_METHOD]
    parts = ["## なぜ", "", *(why or [PR_PLACEHOLDERS["why"]]), "",
             "## 完了の条件", "", *[f"- [ ] {c}" for c in conditions], "", PR_PLACEHOLDERS["evidence"], "",
             "## 変えてはいけないこと", "", *[f"- {i}" for i in dedup(keep) or ["なし"]], "",
             "## 対象外", "", *[f"- {i}" for i in dedup(scope) or ["なし"]], "",
             "## 確認したこと", "", f"- {PR_PLACEHOLDERS['verified']}", "",
             "## ADR と残さなかった決定", "",
             "ADR は、この PR を main にマージしたときに採用になる。残したくないものがあれば、マージの前に外す。", "",
             "残したもの", "", *(kept or ["- なし"]), "", "残さなかった決定", "", *(not_kept or ["- なし"]), "",
             "## マージの前に行う確認", "", *[f"{i}. {s}" for i, s in enumerate(dedup(manual) or ["なし"], 1)], "",
             PR_PLACEHOLDERS["order"], "",
             "## マージの後に行うこと", "", *[f"{i}. {s}" for i, s in enumerate(after or ["なし"], 1)], "",
             "## マージの方法", "", *method, ""]
    return "\n".join(parts), conditions


def cmd_pr_body(args) -> str:
    return pr_body_skeleton(Plan(args.plan_dir))[0]


def pr_body_problems(text: str, conditions: list[str]) -> list[str]:
    lines = text.splitlines()
    problems = [f"下書きの置き換える場所が残っています: {v}" for v in PR_PLACEHOLDERS.values() if v in text]
    for title in PR_REQUIRED:
        if find_section(lines, title) is None:
            problems.append(f"節「{title}」がありません")
    written = "\n".join(find_section(lines, "完了の条件") or [])
    for c in conditions:
        if c not in written:
            problems.append(f"完了の条件の「{c}」がありません（README から写した文は変えない）")
    if DO_NOT_MERGE in text:
        problems.append(f"「{DO_NOT_MERGE}」の注意が残っています")
    boxes = [line for line in lines if CHECKBOX.match(line)]
    stray = [line for line in boxes if line not in (find_section(lines, "完了の条件") or [])]
    if stray:
        problems.append("チェックボックスは「完了の条件」だけに使います（PR の一覧の n of m tasks を数えさせるため）: " + " / ".join(stray[:3]))
    return problems


def cmd_pr_finalize(args) -> dict:
    plan = Plan(args.plan_dir)
    text = Path(args.body).read_text(encoding="utf-8")
    _, conditions = pr_body_skeleton(plan)
    problems = pr_body_problems(text, conditions)
    if problems:
        return {"ok": False, "problems": problems}
    pr = gh_json(["pr", "view", plan.feature, "--json", "number,url,state"])
    if pr["state"] != "OPEN":
        raise Failure(f"機能の PR #{pr['number']} は {pr['state']} です")
    edit_pr(pr["number"], with_attribution(text), title=plan.pr_title)
    return {"ok": True, "pr": pr["url"], "title": plan.pr_title}


# ---------------------------------------------------------------- ci


def wait_ci(feature: str, timeout: int = CI_TIMEOUT_SECONDS, interval: int = CI_POLL_SECONDS,
            appear_grace: int = CI_APPEAR_GRACE_SECONDS) -> dict:
    start = time.monotonic()
    while True:
        waited = int(time.monotonic() - start)
        proc = run(["gh", "pr", "checks", feature, "--json", "name,bucket,link"], check=False)
        try:
            checks = json.loads(proc.stdout) if proc.stdout.strip() else None
        except json.JSONDecodeError:
            checks = None
        if checks is None:
            message = (proc.stderr or proc.stdout).strip()
            if "no pull requests found" in message:
                return {"ok": True, "ci": "none", "checks": [], "waited_seconds": waited,
                        "note": "機能の PR がまだありません（最初のフェーズの前）"}
            if "no checks reported" not in message:
                raise Failure(f"gh pr checks が失敗しました: {message}")
            if waited >= appear_grace:
                return {"ok": True, "ci": "none", "checks": [], "waited_seconds": waited,
                        "note": f"{appear_grace} 秒待ってもチェックが現れません。このリポジトリの CI が機能の PR で走るかを確かめます"}
        else:
            buckets = [c.get("bucket") for c in checks]
            summary = []
            for c in checks:
                item = {"name": c.get("name"), "bucket": c.get("bucket"), "link": c.get("link")}
                found = re.search(r"/actions/runs/([0-9]+)", c.get("link") or "")
                if found:
                    item["run_id"] = found.group(1)
                summary.append(item)
            if "pending" not in buckets:
                failed = any(b in ("fail", "cancel") for b in buckets)
                out = {"ok": True, "ci": "fail" if failed else "pass", "checks": summary, "waited_seconds": waited}
                if failed:
                    out["note"] = "落ちたチェックのログは gh run view <run_id> --log-failed で読む"
                return out
            if waited >= timeout:
                return {"ok": True, "ci": "pending", "checks": summary, "waited_seconds": waited,
                        "note": "まだ終わっていません。同じコマンドをもう一度実行して待ちます"}
        time.sleep(interval)


def cmd_ci(args) -> dict:
    return wait_ci(Plan(args.plan_dir).feature, args.timeout, args.interval, args.appear_grace)


def post_push_items(plan: Plan, name: str) -> list[str]:
    """フェーズの計画書の「push の後の確認」と、そのフェーズが push の後にしか確かめられなかった完了の条件
    （結果ファイルの post_push。前の版のワーカーがコミットで「（push の後に確かめる）」とした完了の条件も読む）。"""
    items = bullets(find_section(PhasePlan(str(plan.phase_file(name))).lines, "push の後の確認"))
    for text in (read_result(plan, name, None) or {}).get("post_push") or []:
        if text and text not in items:
            items.append(text)
    base = base_branch()
    for sha in git("rev-list", f"origin/{base}..origin/{plan.feature}", check=False).split():
        body = git("log", "-1", "--format=%B", sha).splitlines()
        if not any(line.startswith("フェーズ") and name in re.findall(WORK_NAME, line) for line in body):
            continue
        for item in bullets([line for line in body if POST_PUSH_MARK in line]):
            text = item.replace(POST_PUSH_MARK, "").strip()
            if text and text not in items:
                items.append(text)
    return items


def cmd_previous(args) -> dict:
    """フェーズのワーカーが自分の push の前に呼ぶ。前の push の CI を待ち、1 つ前のフェーズの「push の後の確認」を出す。"""
    plan = Plan(args.plan_dir)
    names = plan.phase_names()
    if args.name not in names:
        raise Failure(f"作業名 {args.name} が計画の README のフェーズ表にありません")
    index = names.index(args.name)
    previous = None
    if index:
        name = names[index - 1]
        previous = {"name": name, "file": str(plan.phase_file(name)), "post_push": post_push_items(plan, name)}
    return {**wait_ci(plan.feature, args.timeout, args.interval, args.appear_grace), "previous": previous}


# ---------------------------------------------------------------- result・stops


def cmd_result(args) -> dict:
    plan_dir = Path(args.plan_dir).expanduser().resolve()
    if not NAME.match(args.name):
        raise Failure(f"名前は英小文字・数字・ハイフンだけにします: {args.name}")
    if args.status == "stopped" and not args.stopped_reason:
        raise Failure("status が stopped のときは --stopped-reason に、止めた理由と人に決めてほしいことを書きます")
    data = {
        "name": args.name,
        "skill": args.skill,
        "status": args.status,
        "commit": args.commit,
        "branch": args.branch or git("symbolic-ref", "--quiet", "--short", "HEAD", check=False) or None,
        "pr": args.pr,
        "ci": args.ci,
        "previous_ci": args.previous_ci,
        "summary": args.summary,
        "manual_steps": args.manual_step or [],
        "post_push": args.post_push or [],
        "not_kept": args.not_kept or [],
        "stopped_reason": args.stopped_reason,
    }
    path = plan_dir / ".runs" / f"{args.name}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return {"ok": True, "written": str(path), "result": data}


def read_history(plan: Plan) -> list[dict]:
    path = plan.runs / "history.jsonl"
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def cmd_stops(args) -> dict:
    plan = Plan(args.plan_dir)
    stops = [h for h in read_history(plan) if not h.get("ok")]
    return {"ok": True, "count": len(stops), "stops": stops}


# ---------------------------------------------------------------- usage（時間・モデル・エフォート・トークン）

# 数字の正は Claude Code の会話の記録（<設定のフォルダ>/projects/<フォルダ>/<会話の ID>.jsonl と、そのサブエージェント）。
# 記録は cleanupPeriodDays（既定 30 日）で消えるので、読めるうちに .runs/usage/<会話の ID>.json に写しておく。
# 対話の会話（要件定義と計画）は指揮役が起動しないので、それぞれのスキルが会話の ID を .runs/sessions.jsonl に書く。
USAGE_STAGES = {"requirements": "要件定義", "plan": "計画"}
TOKEN_KEYS = ("input", "cache_read", "cache_write", "output", "thinking")


def read_jsonl(path: Path) -> list[dict]:
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def cmd_session(args) -> dict:
    plan = Plan(args.plan_dir)
    if not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", args.session_id):
        raise Failure(f"会話の ID の形が違います: {args.session_id}（スキルの ${{CLAUDE_SESSION_ID}} が展開されていない）")
    path = plan.runs / "sessions.jsonl"
    rows = read_jsonl(path)
    recorded = not any(r.get("session_id") == args.session_id and r.get("stage") == args.stage for r in rows)
    if recorded:
        plan.runs.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as f:
            f.write(json.dumps({"at": now(), "stage": args.stage, "session_id": args.session_id, "config_dir": str(config_dir())},
                               ensure_ascii=False) + "\n")
    return {"ok": True, "recorded": recorded, "path": str(path)}


def utc_stamp(at: dt.datetime) -> str:
    """会話の記録の timestamp と同じ形（UTC の ISO 8601 と Z）。文字列のままで前後を比べられる。"""
    return at.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


def session_usage(transcript: Path, until: str | None = None) -> dict:
    """会話の記録とそのサブエージェントの記録から、モデルごとのトークン、エフォート、時間を数える。
    until（UTC の文字列）より後の発言は数えない（要件定義と計画の会話を、実装が始まった後も続けたときのため）。"""
    files = [transcript, *sorted(transcript.with_suffix("").glob("subagents/*.jsonl"))]
    models: dict[str, dict[str, int]] = {}
    efforts: dict[str, int] = {}
    seen: set[str] = set()
    first = last = None
    turns: list[tuple[float, float]] = []
    turn_ms = 0
    cost = None
    later = 0
    for index, path in enumerate(files):
        main = index == 0
        for line in path.open(encoding="utf-8", errors="replace"):
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            stamp = event.get("timestamp")
            kind = event.get("type")
            if until and stamp and stamp > until:
                later += kind == "assistant"
                continue
            if main and stamp:
                first = first or stamp
                last = stamp
            if main and kind == "system" and event.get("subtype") == "turn_duration":
                ms = event.get("durationMs") or 0
                if stamp:
                    end = dt.datetime.fromisoformat(stamp.replace("Z", "+00:00")).timestamp()
                    turns.append((end - ms / 1000, end))
                else:
                    turn_ms += ms
            elif main and kind == "cost-state":
                cost = event
            elif kind == "assistant":
                message = event.get("message") or {}
                usage = message.get("usage")
                model = message.get("model") or "?"
                if not usage or model == "<synthetic>" or message.get("id") in seen:
                    continue
                seen.add(message.get("id"))
                counts = models.setdefault(model, dict.fromkeys((*TOKEN_KEYS, "requests"), 0))
                counts["input"] += usage.get("input_tokens") or 0
                counts["cache_read"] += usage.get("cache_read_input_tokens") or 0
                counts["cache_write"] += usage.get("cache_creation_input_tokens") or 0
                counts["output"] += usage.get("output_tokens") or 0
                counts["thinking"] += (usage.get("output_tokens_details") or {}).get("thinking_tokens") or 0
                counts["requests"] += 1
                effort = event.get("effort") or "（なし）"
                efforts[effort] = efforts.get(effort, 0) + 1

    def seconds(a: str | None, b: str | None) -> int | None:
        if not a or not b:
            return None
        parse = lambda s: dt.datetime.fromisoformat(s.replace("Z", "+00:00"))  # noqa: E731
        return int((parse(b) - parse(a)).total_seconds())

    # ターンの時間は重なることがある（ある計画では、2 つのターンの記録が重なり、135 分の会話を
    # 204 分と数えていた）。重なった所は 1 回だけ数える。
    covered, until_end = 0.0, None
    for start, end in sorted(turns):
        if until_end is None or start > until_end:
            covered += end - start
            until_end = end
        elif end > until_end:
            covered += end - until_end
            until_end = end
    turn_ms += int(covered * 1000)
    # cost-state は書いた時点の会話の合計なので、後ろを数えないときは使わない（Claude Code の推定。請求ではない）。
    whole = cost if cost and not later else None
    return {"session_id": transcript.stem, "transcript": str(transcript), "first": first, "last": last,
            "elapsed_seconds": seconds(first, last), "turn_seconds": turn_ms // 1000 if turn_ms else None,
            "api_seconds": (whole.get("totalAPIDuration") or 0) // 1000 if whole else None,
            "cost_usd": whole.get("totalCostUSD") if whole else None, "models": models, "efforts": efforts,
            "subagents": len(files) - 1, "not_counted_after_start": later, "snapshot_at": now()}


def project_folder(path: str) -> str:
    """Claude Code が会話を置くフォルダの名前（作業フォルダのパスの英数字以外を - にしたもの）。"""
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def first_command(transcript: Path) -> tuple[str, str] | None:
    """会話の最初のスラッシュコマンドのスキルの名前と引数（/shipstack:implementing-plan-phase <計画書> なら
    implementing-plan-phase と計画書）。プラグインの名前（前の名前の plan-phases も）は外す。"""
    with transcript.open(encoding="utf-8", errors="replace") as f:
        for _, line in zip(range(60), f):
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if event.get("type") != "user":
                continue
            content = (event.get("message") or {}).get("content")
            text = content if isinstance(content, str) else " ".join(
                b.get("text", "") for b in content or [] if isinstance(b, dict) and b.get("type") == "text")
            name = re.search(r"<command-name>/?([^<]+)</command-name>", text)
            if name:
                found = re.search(r"<command-args>([^<]*)</command-args>", text)
                return name.group(1).strip().split(":")[-1], (found.group(1) if found else "").strip()
            match = re.match(r"/(?:[a-z0-9-]+:)?([a-z][a-z0-9-]*)\s+(\S+)", text.strip())
            return (match.group(1), match.group(2)) if match else None
    return None


def plan_sessions(plan: Plan) -> list[dict]:
    """この計画の会話。スキルが書いた要件定義と計画、指揮役の記録したワーカー、それに、指揮役の外で動いたワーカー
    （手で起動した、指揮役が記録する前に止まった）を、同じフォルダの会話の最初のコマンドから見つける。"""
    rows: list[dict] = []
    for r in read_jsonl(plan.runs / "sessions.jsonl"):
        rows.append({"step": USAGE_STAGES.get(r.get("stage"), r.get("stage")), "kind": r.get("stage"),
                     "session_id": r["session_id"], "config_dir": r.get("config_dir")})
    workers: dict[str, dict] = {}
    for h in read_history(plan):
        if not h.get("session_id"):
            continue
        # 途中で切れて再開した会話は、起動ごとに記録がある。会話は 1 つなので、トークンは 1 回だけ数え、経過は足す
        row = workers.get(h["session_id"])
        if row is None:
            row = workers[h["session_id"]] = {"step": h["name"], "kind": "worker", "session_id": h["session_id"],
                                              "config_dir": h.get("config_dir"), "seconds": 0}
            rows.append(row)
        row["seconds"] += h.get("seconds") or 0
        row["config_dir"] = h.get("config_dir") or row["config_dir"]
    known = {r["session_id"] for r in rows}
    folders: set[Path] = set()
    for r in rows:
        found = transcript_of(r["session_id"], r.get("config_dir"))
        if found:
            folders.add(found.parent)
    folders.add(config_dir() / "projects" / project_folder(os.environ.get("SHIPSTACK_REPO") or repo_root()))
    belongs = re.compile(rf"(^|/){re.escape(plan.name)}(/|$)")
    skills = {skill: kind for kind, (skill, _, _) in WORKERS.items()}
    for folder in sorted(folders):
        for transcript in sorted(folder.glob("*.jsonl")) if folder.is_dir() else []:
            if transcript.stem in known:
                continue
            command = first_command(transcript)
            if not command or not belongs.search(command[1]):
                continue
            skill, target = command
            if skill == "writing-implementation-plan":
                rows.append({"step": USAGE_STAGES["plan"], "kind": "plan", "session_id": transcript.stem, "config_dir": None})
            elif skill in skills:
                if skills[skill] == "phase":
                    phase = plan.dir / Path(target).name
                    name = PhasePlan(str(phase)).name if phase.exists() else Path(target).stem
                else:
                    name = f"{plan.name}-{WORKERS[skills[skill]][1]}"
                rows.append({"step": name, "kind": "worker", "session_id": transcript.stem, "config_dir": None,
                             "found_without_record": True})
            known.add(transcript.stem)
    return rows


def first_worker_start(plan: Plan) -> str | None:
    starts = [dt.datetime.fromisoformat(h["at"]) - dt.timedelta(seconds=h.get("seconds") or 0)
              for h in read_history(plan) if h.get("at")]
    return utc_stamp(min(starts)) if starts else None


def refresh_usage(plan: Plan, only: str | None = None) -> list[dict]:
    """読める会話の記録から .runs/usage/ を書き直し、この計画の会話を、写しと一緒に返す（記録が消えた会話は写しだけ）。"""
    folder = plan.runs / "usage"
    cutoff = first_worker_start(plan)
    out = []
    for row in plan_sessions(plan):
        snapshot = folder / f"{row['session_id']}.json"
        if only is None or row["session_id"] == only:
            transcript = transcript_of(row["session_id"], row.get("config_dir"))
            if transcript:
                usage = session_usage(transcript, cutoff if row["kind"] in USAGE_STAGES else None)
                folder.mkdir(parents=True, exist_ok=True)
                snapshot.write_text(json.dumps({**row, **usage}, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        if snapshot.exists():
            out.append({**json.loads(snapshot.read_text(encoding="utf-8")), **{k: v for k, v in row.items() if k == "seconds"}})
        else:
            out.append({**row, "missing": True})
    return out


def usage_table(rows: list[dict]) -> dict:
    """会話を手順ごとにまとめる。時間は、ワーカーは指揮役が測った経過、対話の会話は AI が動いた時間（ターンの合計）。"""
    steps: dict[str, dict] = {}
    for row in rows:
        step = steps.setdefault(row["step"], {"step": row["step"], "kind": row.get("kind"), "seconds": 0, "elapsed_seconds": 0,
                                              "models": {}, "efforts": {}, "cost_usd": 0.0, "cost_known": True,
                                              "sessions": 0, "missing": 0, "first": None})
        step["sessions"] += 1
        if row.get("missing"):
            step["missing"] += 1
            continue
        if row.get("kind") == "worker" and row.get("seconds") is not None:
            step["seconds"] += row["seconds"]
        else:
            step["seconds"] += row.get("turn_seconds") or row.get("elapsed_seconds") or 0
        step["elapsed_seconds"] += row.get("elapsed_seconds") or 0
        step["first"] = min(filter(None, (step["first"], row.get("first")))) if row.get("first") else step["first"]
        for model, counts in (row.get("models") or {}).items():
            total = step["models"].setdefault(model, dict.fromkeys((*TOKEN_KEYS, "requests"), 0))
            for key, value in counts.items():
                total[key] = total.get(key, 0) + value
        for effort, n in (row.get("efforts") or {}).items():
            step["efforts"][effort] = step["efforts"].get(effort, 0) + n
        if row.get("cost_usd") is None:
            step["cost_known"] = False
        else:
            step["cost_usd"] += row["cost_usd"]
    order = {"requirements": 0, "plan": 1}
    ordered = sorted(steps.values(), key=lambda s: (order.get(s["kind"], 2), s["first"] or ""))
    return {"steps": ordered}


def tokens_of(step: dict, key: str) -> int:
    return sum(c.get(key, 0) for c in step["models"].values())


def usage_lines(table: dict, plan_name: str = "") -> list[str]:
    def short(n: int) -> str:
        return f"{n / 1e6:.1f}M" if n >= 1e6 else f"{n / 1e3:.0f}k"

    def models(step: dict) -> str:
        names = sorted(step["models"], key=lambda m: -step["models"][m]["requests"])
        efforts = "・".join(f"{e}" for e in sorted(step["efforts"], key=lambda e: -step["efforts"][e]))
        return f"{'、'.join(n.removeprefix('claude-') for n in names) or '—'}（{efforts or '—'}）"

    lines = [f"{'手順':<24}{'時間':>7}  {'入力':>7}{'うちキャッシュ':>8}{'出力':>7}{'思考':>7}{'推定費用':>9}  モデル（エフォート）"]
    groups = {"要件定義と計画": [], "実装": []}
    for step in table["steps"]:
        groups["要件定義と計画" if step["kind"] in USAGE_STAGES else "実装"].append(step)
        cost = "—" if not step["cost_known"] and not step["cost_usd"] else f"${step['cost_usd']:.2f}" + ("" if step["cost_known"] else "+")
        note = "（記録が消えた）" if step["missing"] == step["sessions"] else ""
        label = step["step"].removeprefix(f"{plan_name}-") if plan_name else step["step"]
        lines.append(f"{label:<24}{step['seconds'] // 60:>5}分  {short(tokens_of(step, 'input') + tokens_of(step, 'cache_read') + tokens_of(step, 'cache_write')):>7}"
                     f"{short(tokens_of(step, 'cache_read')):>8}{short(tokens_of(step, 'output')):>7}{short(tokens_of(step, 'thinking')):>7}"
                     f"{cost:>9}  {models(step)}{note}")
    for label, steps in [*groups.items(), ("合計", table["steps"])]:
        if not steps:
            continue
        inp = sum(tokens_of(s, k) for s in steps for k in ("input", "cache_read", "cache_write"))
        cost = sum(s["cost_usd"] for s in steps)
        partial = "+" if not all(s["cost_known"] for s in steps) else ""
        lines.append(f"{'= ' + label:<24}{sum(s['seconds'] for s in steps) // 60:>5}分  {short(inp):>7}"
                     f"{short(sum(tokens_of(s, 'cache_read') for s in steps)):>8}{short(sum(tokens_of(s, 'output') for s in steps)):>7}"
                     f"{short(sum(tokens_of(s, 'thinking') for s in steps)):>7}{'$' + format(cost, '.2f') + partial:>9}")
    return lines


def cmd_usage(args) -> dict | str:
    plan = Plan(args.plan_dir)
    rows = refresh_usage(plan)
    table = usage_table(rows)
    if args.json:
        return {"ok": True, **table}
    notes = ["時間: ワーカーは指揮役が測った経過、要件定義と計画は AI が動いた時間（人が考えている間を除く。ターンの合計）",
             "入力: キャッシュの読み書きを含む。推定費用は Claude Code の推定（請求ではない。+ は推定の無い会話を含む）",
             f"写し: {plan.runs / 'usage'}（会話の記録は既定で 30 日で消えるので、読めるうちに写す）"]
    later = sum(r.get("not_counted_after_start") or 0 for r in rows)
    if later:
        notes.append(f"要件定義と計画の会話で、実装が始まった後の発言 {later} 件は数えていない")
    return "\n".join(usage_lines(table, plan.name) + [""] + [f"- {n}" for n in notes]) + "\n"


# ---------------------------------------------------------------- run（指揮役）


def now() -> str:
    return dt.datetime.now().astimezone().isoformat(timespec="seconds")


def say(message: str) -> None:
    print(f"[{dt.datetime.now().strftime('%H:%M:%S')}] {message}", flush=True)


def notify(message: str) -> None:
    if os.environ.get("SHIPSTACK_NOTIFY", "1") == "0" or not shutil.which("osascript"):
        return
    script = f'display notification {json.dumps(message)} with title "shipstack" sound name "Glass"'
    subprocess.run(["osascript", "-e", script], capture_output=True)


class Stop(Exception):
    """run を止めて、人に知らせる（終了コード 1）。"""


def confirm_prerequisites(plan: Plan, assume_yes: bool, dry_run: bool) -> None:
    items = plan.prerequisites()
    if not items:
        return
    digest = hashlib.sha256("\n".join(items).encode()).hexdigest()
    path = plan.runs / "prerequisites.json"
    if path.exists() and json.loads(path.read_text(encoding="utf-8")).get("digest") == digest:
        return
    say("計画の README の「開始前に人がすること」:")
    for i, item in enumerate(items, 1):
        print(f"  {i}. {item}")
    if dry_run:
        say("（dry-run なので確かめません。本番では、ここで済んだかを聞きます）")
        return
    if not assume_yes:
        if not sys.stdin.isatty():
            raise Stop("「開始前に人がすること」が済んだかを確かめられません。済ませてから --yes を付けて打ち直します")
        answer = input("すべて済みましたか？ [y/N] ").strip().lower()
        if answer not in ("y", "yes"):
            raise Stop("「開始前に人がすること」を済ませてから打ち直します")
    plan.runs.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"confirmed_at": now(), "digest": digest, "items": items}, ensure_ascii=False, indent=2) + "\n",
                    encoding="utf-8")


def create_branch(plan: Plan, base: str) -> None:
    say(f"origin/{base} から {plan.feature} を作って push します")
    git("push", "origin", f"refs/remotes/origin/{base}:refs/heads/{plan.feature}")
    git("fetch", "origin")


def dirty_files() -> list[str]:
    return [line for line in git("status", "--porcelain").splitlines() if line]


def ensure_checkout(plan: Plan, resuming: bool = False) -> None:
    """ワーカーは機能ブランチのチェックアウトで直接作業する。きれいなら切り替えて最新にし、汚れていれば止める。
    途中で切れたワーカーを再開するときは、手元の変更とコミットはそのワーカーのものなので、ブランチだけを確かめる。"""
    feature = plan.feature
    branch = git("symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    if resuming:
        if branch != feature:
            raise Stop(f"手元のブランチが {branch or '（切り離された HEAD）'} です。途中で切れたワーカーの作業は {feature} にあるはずなので、"
                       f"切り替えてから打ち直します（続けずに捨てるなら、手元を片付けてから --fresh を付けて打ち直す）")
        return
    dirty = dirty_files()
    if dirty:
        raise Stop(f"未コミットの変更が {len(dirty)} 件あります（{'、'.join(dirty[:5])}）。途中で切れたワーカーの記録が無いので触りません。"
                   "変更を片付けてから打ち直します")
    if branch != feature:
        if git_ok("rev-parse", "--verify", "--quiet", f"refs/heads/{feature}"):
            git("switch", feature)
        else:
            git("switch", "-c", feature, "--track", f"origin/{feature}")
        say(f"{feature} に切り替えました")
    behind, ahead = git("rev-list", "--left-right", "--count", f"origin/{feature}...HEAD").split()
    if int(ahead):
        raise Stop(f"手元の {feature} に、push していないコミットが {ahead} 件あります。確かめてから打ち直します")
    if int(behind):
        git("merge", "--ff-only", f"origin/{feature}")
        say(f"手元の {feature} を origin に合わせました（{behind} 件）")


def config_dir() -> Path:
    """ワーカーが使う Claude Code の設定のフォルダ（アカウント）。claude は CLAUDE_CONFIG_DIR が無ければ ~/.claude を使う。"""
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude").expanduser().resolve()


def resume_command(session_id: str, config: str | None = None) -> str:
    """ワーカーの会話を開くコマンド。会話は設定のフォルダごとに保存されるので、~/.claude 以外で動かしたなら
    CLAUDE_CONFIG_DIR を付ける（付けずに開くと「No conversation found」になる。2026-11-05 に確かめた）。"""
    path = Path(config).expanduser().resolve() if config else config_dir()
    if path == Path("~/.claude").expanduser().resolve():
        return f"claude -r {session_id}"
    try:
        shown = "~/" + shlex.quote(str(path.relative_to(Path.home())))
    except ValueError:
        shown = shlex.quote(str(path))
    return f"CLAUDE_CONFIG_DIR={shown} claude -r {session_id}"


def recent_failures(history: list[dict], name: str) -> int:
    """続けてうまくいかなかった回数。途中で切れただけの記録（interrupted）と、起動の確かめで止めた記録（launch）は、
    ワーカーの失敗ではないので数えない。"""
    count = 0
    for entry in reversed([h for h in history if h.get("name") == name and not h.get("interrupted") and not h.get("launch")]):
        if entry.get("ok"):
            break
        count += 1
    return count


# ---------------------------------------------------------------- 途中で切れたワーカー


def read_active(plan: Plan) -> dict | None:
    """動いている、または途中で切れたワーカー（.runs/active.json）。ワーカーが結果ファイルを書いて終えたら消す。"""
    path = plan.runs / "active.json"
    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else None


def write_active(plan: Plan, active: dict) -> None:
    plan.runs.mkdir(parents=True, exist_ok=True)
    (plan.runs / "active.json").write_text(json.dumps(active, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def clear_active(plan: Plan) -> None:
    (plan.runs / "active.json").unlink(missing_ok=True)


def interrupted_from_history(plan: Plan) -> dict | None:
    """active.json を書く前の指揮役が記録した、結果ファイルを書かずに終わったワーカー（最後の記録だけを見る）。"""
    history = read_history(plan)
    if not history:
        return None
    last = history[-1]
    problems = last.get("problems") or []
    unfinished = last.get("interrupted") or any(
        p.startswith("ワーカーが失敗で終わりました") or p.startswith("ワーカーが結果ファイル") for p in problems)
    kind = next((k for k, (skill, _, _) in WORKERS.items() if skill == last.get("skill")), None)
    if last.get("ok") or last.get("stopped") or not unfinished or not kind or not last.get("session_id"):
        return None
    started = dt.datetime.fromisoformat(last["at"]).timestamp() - (last.get("seconds") or 0)
    return {"name": last["name"], "kind": kind, "skill": last["skill"], "session_id": last["session_id"],
            "config_dir": last.get("config_dir"), "started": started, "resumes": 0,
            "reason": (problems[0] if problems else "")[:300]}


def transcript_of(session_id: str, config: str | None) -> Path | None:
    """会話の記録ファイル。--resume にパスで渡すと、別のアカウント（設定のフォルダ）からでも同じ会話を続けられる
    （2026-11-07 に 2.1.319 で確かめた。続きは元のファイルに書き足される）。"""
    for base in dict.fromkeys(p for p in (Path(config).expanduser() if config else None, config_dir()) if p):
        hits = sorted(base.glob(f"projects/*/{session_id}.jsonl"))
        if hits:
            return hits[0]
    return None


def limit_reached(text: str) -> bool:
    return "limit" in text.lower() or "上限" in text


def resume_pause() -> int:
    return int(os.environ.get("SHIPSTACK_RESUME_PAUSE", RESUME_PAUSE_SECONDS))


def claude_command(plan: Plan, step: dict, session_id: str, resume_from: str | None = None) -> list[str]:
    kind = step["kind"]
    cmd = [os.environ.get("SHIPSTACK_CLAUDE", "claude"), "-p",
           "--output-format", "stream-json", "--verbose",
           "--permission-mode", os.environ.get("SHIPSTACK_PERMISSION_MODE", "auto"),
           "--permission-prompts", "none"]
    cmd += ["--resume", resume_from] if resume_from else ["--session-id", session_id]
    if os.environ.get("SHIPSTACK_MODEL"):
        cmd += ["--model", os.environ["SHIPSTACK_MODEL"]]
    # 再開した会話にも渡す（--effort はその起動の会話にだけ効く）。
    cmd += ["--effort", step["effort"]]
    if PLUGIN_ROOT:
        # 指揮役と guard.sh と同じ版のスキルで動かす。同じ名前のインストール済みのプラグインは、その会話だけ置き換わる
        # （https://code.claude.com/docs/en/plugins/loading#name-conflicts ）。ワーカーを動かす設定のフォルダに入れなくてよい
        cmd += ["--plugin-dir", str(PLUGIN_ROOT)]
    settings: dict = {}
    if plan.allow_rules:
        # 許可ルールに合う操作は分類器を通らずに通る。合わない部分をつなぐと分類器に回る（スキルが単独で実行させる）。
        settings["permissions"] = {"allow": plan.allow_rules}
    # 再開した会話ではスキルのフックが登録されないので、同じ決まりのフックをここでも渡す（新しい会話では 2 回動くが、結果は同じ）。
    # フックが落ちたり時間切れになったりしたときは、既定ではコマンドが通る。onFailure: block で止める（2.1.295 以上。
    # https://code.claude.com/docs/en/hooks#block-the-action-when-a-hook-fails 。2026-11-18 に 2.1.327 で確かめた）。
    # SessionStart のフックは起動の確かめに使う（dispatch）。標準エラーに書くので、Claude の文脈には入らない。
    settings["hooks"] = {
        "PreToolUse": [{"matcher": "Bash", "hooks": [
            {"type": "command", "command": f"{shlex.quote(str(GUARD))} {GUARD_ROLES[kind]}", "timeout": 30,
             "onFailure": "block"}]}],
        "SessionStart": [{"hooks": [{"type": "command", "command": f"echo {HOOKS_ON} >&2", "timeout": 10}]}]}
    # 利用者とリポジトリの設定に左右されないように、ここで決める（コマンドラインの設定は、プロジェクトとユーザーの設定より強い。
    # https://code.claude.com/docs/en/settings#settings-precedence ）。ultracode が付いていると、ワーカーが手順ごとに
    # dynamic workflow を組む。disableAllHooks が付いていると、決まりのフックが止まる。
    settings["ultracode"] = False
    settings["disableAllHooks"] = False
    cmd += ["--settings", json.dumps(settings, ensure_ascii=False)]
    # --add-dir は値をいくつでも取るので最後に置き、プロンプトは標準入力で渡す。
    return cmd + ["--add-dir", str(plan.dir)]


RETRY_ERRORS = {"rate_limit": "利用上限か流量の制限", "overloaded": "API の混雑", "server_error": "API の失敗",
                "unknown": "通信の失敗など"}


def launch_problems(init: dict, hooks_on: bool) -> list[str]:
    """ワーカーの system/init と、それより前に流れたフックの記録から、動かしてはいけない理由を返す（無ければ空）。"""
    problems = []
    wanted = os.environ.get("SHIPSTACK_PERMISSION_MODE", "auto")
    mode = init.get("permissionMode")
    if mode != PERMISSION_MODE_ALIASES.get(wanted, wanted):
        problems.append(f"ワーカーが {wanted} ではなく {mode} の権限のモードで始まりました。auto mode が使えない（設定の disableAutoMode、"
                        "auto mode に対応していないモデル、サーバー側で止まっている）と Manual で始まり、書き込みがすべて誰にも聞かずに"
                        "拒否されます。claude を開いて auto mode に切り替えられるかを確かめます")
    if PLUGIN and not any(p.get("name") == PLUGIN for p in init.get("plugins") or []):
        errors = "、".join(f"{e.get('plugin')}: {e.get('message')}" for e in init.get("plugin_errors") or []) or "エラーの記録なし"
        problems.append(f"ワーカーに {PLUGIN} プラグインが読み込まれませんでした（{errors}）。--plugin-dir {PLUGIN_ROOT} を確かめます")
    if not hooks_on:
        problems.append("ワーカーで --settings のフックが動きませんでした。決まりのフック（guard.sh）が効かないので動かしません"
                        "（--bare か CLAUDE_CODE_SIMPLE で動いた、管理者の設定の disableAllHooks か strictPluginOnlyCustomization、など）")
    return problems


def dispatch(plan: Plan, step: dict, root: str, resume: dict | None = None) -> dict:
    """ワーカーを 1 つ動かす。resume があれば、新しい会話ではなく、途中で切れたその会話を続きから再開する。"""
    if resume:
        session_id = resume["session_id"]
        transcript = transcript_of(session_id, resume.get("config_dir"))
        account = str(transcript.parents[2]) if transcript else str(config_dir())
        cmd = claude_command(plan, step, session_id, str(transcript) if transcript else session_id)
        prompt = RESUME_PROMPT.format(reason=resume.get("reason") or "理由は記録されていません", prompt=step["prompt"])
        resumes = int(resume.get("resumes") or 0) + 1
        started = float(resume["started"])
        # 再開した会話の total_cost_usd は、前の実行の分も含んだ会話の合計（公式の説明と、2026-11-07 の e2e で確かめた）。
        spent_before = float(resume.get("cost_total") or 0)
        say(f"↻ {step['name']}（{step['skill']}）の会話を続きから再開します（{resumes} 回目）。会話: {resume_command(session_id, account)}")
    else:
        session_id = str(uuid.uuid4())
        account = str(config_dir())
        cmd = claude_command(plan, step, session_id)
        prompt = step["prompt"]
        resumes = 0
        started = time.time()
        spent_before = 0.0
        say(f"▶ {step['name']}（{step['skill']}、エフォート {effort_override() or step['effort']}）を始めます。"
            f"会話: {resume_command(session_id)}")
    # 指揮役ごと止まっても（Ctrl+C、端末を閉じた）、次の run がこの会話を続きから再開できるように、起動の前に書く。
    write_active(plan, {"name": step["name"], "kind": step["kind"], "skill": step["skill"], "session_id": session_id,
                        "config_dir": account, "started": started, "at": now(), "resumes": resumes})
    env = {**WORKER_ENV, **os.environ, "SHIPSTACK_REPO": root}
    began = time.time()
    final: dict = {}
    # 拒否は、拒否のたびに流れる system の permission_denied で数える。result の permission_denials だけを
    # 見ていたときは、ある計画の p1（2026-11-05）で、会話にあった分類器の拒否 2 回が 0 と記録された。
    tool_inputs: dict[str, str] = {}
    denials: list[dict] = []
    retrying: dict = {"since": None, "error": None, "count": 0, "notified": False, "shown": 0}
    hooks_on = False
    launch: list[str] = []
    proc = subprocess.Popen(cmd, cwd=root, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    assert proc.stdin and proc.stdout
    proc.stdin.write(prompt)
    proc.stdin.close()
    try:
        for line in proc.stdout:
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if event.get("type") == "system" and event.get("subtype") == "hook_response":
                # SessionStart のフックは init より前に走り終える（https://code.claude.com/docs/en/headless#read-session-metadata ）
                if event.get("hook_event") == "SessionStart" and HOOKS_ON in (event.get("stderr") or ""):
                    hooks_on = True
                continue
            if event.get("type") == "system" and event.get("subtype") == "init":
                launch = launch_problems(event, hooks_on)
                if launch:
                    proc.terminate()
                    break
                loaded = next((p for p in event.get("plugins") or [] if p.get("name") == PLUGIN), None)
                if PLUGIN_ROOT and loaded and loaded.get("path") and Path(loaded["path"]).resolve() != PLUGIN_ROOT:
                    # 管理者の設定でプラグインが固定されていると、--plugin-dir は使われない。動きはするが、版が指揮役とずれうる
                    print(f"    ⚠ ワーカーが読んだ {PLUGIN} は {loaded['path']}（{loaded.get('version')}）で、指揮役の "
                          f"{PLUGIN_ROOT} と違います", flush=True)
                continue
            if event.get("type") == "system" and event.get("subtype") == "api_retry":
                # Claude Code が API の失敗を待って再試行している。待つのは Claude Code に任せ、ここでは知らせるだけにする。
                # watchdog のときは、同じ回数目の待ちの残りを 30 秒ごとにもう一度流す（2026-11-07 に確かめた）。数えるのは回数目が変わったときだけ。
                attempt = int(event.get("attempt") or 0)
                if attempt == retrying["shown"]:
                    continue
                retrying["shown"] = attempt
                delay = (event.get("retry_delay_ms") or 0) / 1000
                error = RETRY_ERRORS.get(event.get("error") or "unknown", event.get("error"))
                at = (dt.datetime.now() + dt.timedelta(seconds=delay)).strftime("%H:%M:%S")
                if retrying["since"] is None:
                    retrying["since"] = time.time()
                if attempt <= 1 or attempt % 10 == 0 or error != retrying["error"] or delay >= 600:
                    print(f"    ⏳ API に届かないので再試行を待っています（{error}、{attempt}/{event.get('max_retries')} 回目、次は {at}）",
                          flush=True)
                if delay >= 600 and not retrying["notified"]:
                    notify(f"{step['name']}: {error}のため {at} まで待っています")
                    retrying["notified"] = True
                retrying["error"] = error
                retrying["count"] += 1
                continue
            texts = [b.get("text") or "" for b in (event.get("message") or {}).get("content") or [] if b.get("type") == "text"]
            api_error = bool(event.get("error")) or any(t.startswith("API Error") for t in texts)
            # 再試行を使い切ったときも、Claude Code は「API Error: …」を assistant の発言として流す。これは戻ったことにしない。
            if event.get("type") == "assistant" and retrying["since"] is not None and not api_error:
                print(f"    ↺ API に戻りました（{int(time.time() - retrying['since']) // 60} 分待った）", flush=True)
                retrying.update(since=None, error=None, notified=False, shown=0)
            if event.get("type") == "assistant":
                for block in (event.get("message") or {}).get("content") or []:
                    if block.get("type") == "tool_use":
                        args = block.get("input") or {}
                        tool_inputs[block.get("id", "")] = str(args.get("command") or args.get("file_path") or args.get("url") or "")
                    elif block.get("type") == "text" and block.get("text", "").strip() and not event.get("parent_tool_use_id"):
                        first = block["text"].strip().splitlines()[0]
                        print(f"    {first[:160]}", flush=True)
            elif event.get("type") == "system" and event.get("subtype") == "permission_denied":
                denial = {"tool": event.get("tool_name"), "reason": event.get("decision_reason") or event.get("decision_reason_type"),
                          "input": tool_inputs.get(event.get("tool_use_id", ""), "")[:300]}
                denials.append(denial)
                print(f"    ⚠ 権限で拒否: {denial['reason']} — {denial['input'][:120]}", flush=True)
            elif event.get("type") == "result":
                final = event
        code = proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        proc.wait()
        raise
    return {"session_id": session_id, "config_dir": account, "exit_code": code, "started": started, "resumes": resumes,
            "seconds": int(time.time() - began), "api_retries": retrying["count"],
            "is_error": bool(final.get("is_error")) or code != 0, "result_text": (final.get("result") or "")[-2000:],
            "cost_total": final.get("total_cost_usd"),
            "cost_usd": None if final.get("total_cost_usd") is None else round(final["total_cost_usd"] - spent_before, 6),
            "permission_denials": max(len(denials), len(final.get("permission_denials") or [])), "denials": denials,
            "launch_problems": launch}


def append_history(plan: Plan, entry: dict) -> None:
    plan.runs.mkdir(parents=True, exist_ok=True)
    with (plan.runs / "history.jsonl").open("a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


def print_state(plan: Plan, state: dict) -> None:
    done = state["phases_done"]
    marks = " ".join(f"{n}{'✓' if n in done else '·'}" for n in plan.phase_names())
    pr = state["pr"]
    finalized = bool(pr) and not pr["title"].startswith("WIP:") and DO_NOT_MERGE not in (pr.get("body") or "")
    say(f"{plan.name}: {marks}  決定と学び{'✓' if state['decisions_done'] or finalized else '·'}  仕上げ{'✓' if finalized else '·'}  "
        f"PR {('#' + str(pr['number']) + ' ' + pr['state']) if pr else 'なし'}")


def final_report(plan: Plan, step: dict) -> None:
    say(step["reason"])
    finalize = read_result(plan, f"{plan.name}-finalize", None)
    if finalize and finalize.get("manual_steps"):
        say("次にあなたがすること（仕上げのワーカーの記録から）:")
        for i, item in enumerate(finalize["manual_steps"], 1):
            print(f"  {i}. {item}")
    feedback = plan.runs / "workflow-feedback.md"
    if feedback.exists():
        say(f"フローへの気づき（スキルや計画の雛形を直す材料）: {feedback}")


def ci_note(step: dict, verified: dict) -> str:
    """終わった手順の行に添える CI。仕上げは待った結果、フェーズは push の前に確かめた前の push の結果。"""
    if step["kind"] == "finalize":
        return f"、CI {verified.get('ci')}"
    previous = (verified.get("result") or {}).get("previous_ci")
    if step["kind"] == "phase" and previous:
        return f"、前の push の CI {previous}"
    return ""


def record_usage(plan: Plan, only: str | None = None) -> list[dict] | None:
    """使った時間とトークンを .runs/usage/ に写す。写せなくても run は止めない。"""
    try:
        return refresh_usage(plan, only)
    except Exception as error:  # noqa: BLE001
        say(f"使った時間とトークンを写せませんでした（{error}）。shipstack usage で写し直せます")
        return None


def cmd_run(args) -> int:
    plan = Plan(args.plan_dir)
    root = repo_root()
    os.environ["SHIPSTACK_REPO"] = root
    try:
        checked = check_plan(plan)
        if checked["problems"]:
            raise Stop("計画の形が決まりと合いません。直してから打ち直します（shipstack check-plan で同じものが出る）:\n"
                       + "\n".join(f"  - {p}" for p in checked["problems"]))
        if checked["warnings"]:
            say(f"計画の形の注意が {len(checked['warnings'])} 件あります（shipstack check-plan で見る）")
        if plan.allow_rules:
            say("ワーカーに渡す許可ルール: " + "、".join(plan.allow_rules))
        if effort_override():
            say(f"環境変数 CLAUDE_CODE_EFFORT_LEVEL（{effort_override()}）が付いているので、どのワーカーもフェーズ表と手順ごとの"
                "エフォートではなく、この値で動きます")
        confirm_prerequisites(plan, args.yes, args.dry_run)
        if not args.dry_run:
            record_usage(plan)  # 要件定義と計画の会話を、記録が消える前に写す
        active = read_active(plan)
        if active and args.fresh:
            if not args.dry_run:
                clear_active(plan)
            say(f"途中で切れた {active['name']} の会話は続けずに捨てます（手元の変更には触りません）")
            active = None
        if active is None and not args.fresh and dirty_files():
            active = interrupted_from_history(plan)
        auto_resumes = 0
        while True:
            state = collect_state(plan)
            print_state(plan, state)
            step = decide(plan, state)
            if step["action"] == "complete":
                if not args.dry_run:
                    clear_active(plan)
                final_report(plan, step)
                rows = None if args.dry_run else record_usage(plan)
                if rows and any(not r.get("missing") for r in rows):
                    say(f"使った時間とトークン（手順ごとは shipstack usage {plan.dir}）:")
                    for line in usage_lines(usage_table(rows), plan.name):
                        if line.startswith("= ") or line.startswith("手順"):
                            print(f"  {line}")
                if not args.dry_run:
                    notify(f"{plan.name}: {step['reason']}")
                return 0
            if step["action"] == "stop":
                raise Stop(step["reason"])
            if step["action"] == "create-branch":
                if args.dry_run:
                    say(f"次: {step['reason']}（dry-run なので作りません）")
                    return 0
                create_branch(plan, state["base"])
                continue
            if active:
                # 途中で切れたワーカーを先に終わらせる（push の後、結果ファイルの前に切れたなら、次のフェーズは既に「次」に見える）。
                step = worker_step(plan, active["kind"], active["name"] if active["kind"] == "phase" else None)
            else:
                failures = recent_failures(read_history(plan), step["name"])
                if failures >= MAX_FAILURES and not args.retry:
                    raise Stop(f"{step['name']} が {failures} 回続けてうまくいきませんでした。前提（計画書・手元）を見直してから、"
                               "--retry を付けて打ち直します（記録: shipstack stops）")
            if args.dry_run:
                if active:
                    say(f"次: 途中で切れた {step['name']}（{step['skill']}）の会話を続きから再開")
                    where = transcript_of(active["session_id"], active.get("config_dir"))
                    print("  " + shlex.join(claude_command(plan, step, active["session_id"], str(where or active["session_id"]))))
                else:
                    say(f"次: {step['name']}（{step['skill']}、エフォート {effort_override() or step['effort']}）")
                    print("  " + shlex.join(claude_command(plan, step, "<新しい ID>"))
                          + f" <<< {json.dumps(step['prompt'], ensure_ascii=False)}")
                return 0
            if active and read_result(plan, step["name"], float(active["started"])) is not None:
                # 打ち直すまでの間に、会話が結果ファイルを書き終えていた（人が会話を開いて続けた、など）。起動せずに確かめる。
                say(f"{step['name']} は結果ファイルを書き終えています。起動せずに確かめます")
                outcome = {"session_id": active["session_id"], "config_dir": active.get("config_dir"), "exit_code": 0,
                           "started": float(active["started"]), "resumes": int(active.get("resumes") or 0), "seconds": 0,
                           "api_retries": 0, "is_error": False, "result_text": "", "cost_usd": None, "cost_total": None,
                           "permission_denials": 0, "denials": []}
            else:
                ensure_checkout(plan, resuming=bool(active))
                outcome = dispatch(plan, step, root, active)
            if outcome.get("launch_problems"):
                # 起動の確かめで止めた。モデルを呼ぶ前なので、ワーカーは何もしていない。新しい会話なら捨て、再開しようとした会話なら
                # active.json を元に戻す（直してから打ち直すと、同じ会話の続きから進む）。ワーカーの失敗としては数えない。
                if active:
                    write_active(plan, active)
                else:
                    clear_active(plan)
                append_history(plan, {"at": now(), "name": step["name"], "skill": step["skill"],
                                      **({"session_id": outcome["session_id"]} if active else {}),
                                      "effort": effort_override() or step["effort"], "config_dir": outcome["config_dir"],
                                      "ok": False, "stopped": False, "launch": True, "problems": outcome["launch_problems"]})
                notify(f"{step['name']} のワーカーを起動の確かめで止めました")
                say(f"■ {step['name']}（{step['skill']}）のワーカーを、起動の確かめで止めました（モデルを呼ぶ前なので、何もしていません）:")
                for problem in outcome["launch_problems"]:
                    print(f"  - {problem}")
                print(f"  直したら、同じコマンドを打ち直す: shipstack run {plan.dir}")
                return 1
            entry = {"at": now(), "name": step["name"], "skill": step["skill"], "session_id": outcome["session_id"],
                     "effort": effort_override() or step["effort"], "config_dir": outcome["config_dir"], "resumes": outcome["resumes"],
                     "seconds": outcome["seconds"], "cost_usd": outcome["cost_usd"], "api_retries": outcome["api_retries"],
                     "permission_denials": outcome["permission_denials"], "denials": outcome["denials"]}
            if read_result(plan, step["name"], outcome["started"]) is None:
                # 結果ファイルを書かずに終わった（API に届かないまま再試行を使い切った、応答が途切れた、など）。仕事の途中なので、
                # 同じ会話を続きから再開する。新しいワーカーにすると、手元の変更が誰のものかわからず、最初からやり直しになる。
                text = outcome["result_text"].strip()
                reason = (text.splitlines()[-1] if text else f"終了コード {outcome['exit_code']}")[:300]
                append_history(plan, {**entry, "ok": False, "stopped": False, "interrupted": True,
                                      "problems": [f"ワーカーが結果ファイルを書かずに終わりました: {reason}"]})
                record_usage(plan, outcome["session_id"])
                active = {**(read_active(plan) or {}), "reason": reason, "cost_total": outcome["cost_total"]}
                write_active(plan, active)
                if auto_resumes < AUTO_RESUMES and not limit_reached(text):
                    auto_resumes += 1
                    say(f"↻ {step['name']} が途中で切れました（{reason}）。{resume_pause()} 秒おいて、同じ会話を続きから再開します")
                    time.sleep(resume_pause())
                    continue
                notify(f"{step['name']} が途中で切れました")
                say(f"■ {step['name']} が途中で切れました: {reason}")
                print(f"  同じコマンドを打ち直すと、この会話の続きから再開します: shipstack run {plan.dir}")
                if limit_reached(text):
                    print("  利用上限なら、戻ってから打ち直すか、別のアカウント（CLAUDE_CONFIG_DIR）で打ち直す。どちらでも同じ会話の続きから進む")
                print(f"  会話を開いて見る: cd {root} && {resume_command(outcome['session_id'], outcome['config_dir'])}")
                print("  続けずに捨てるなら: 手元の変更を片付けてから、--fresh を付けて打ち直す")
                return 1
            clear_active(plan)
            active = None
            auto_resumes = 0
            verified = verify_step(plan, step, since=outcome["started"])
            entry.update(ok=verified["ok"], stopped=verified["stopped"], problems=verified["problems"])
            append_history(plan, entry)
            record_usage(plan, outcome["session_id"])
            if not verified["ok"]:
                kind = "止まって報告しました" if verified["stopped"] else "確かめた結果が合いません"
                notify(f"{step['name']} が{kind}")
                say(f"■ {step['name']} が{kind}:")
                for problem in verified["problems"]:
                    print(f"  - {problem}")
                print(f"  会話を開いて続ける: cd {root} && {resume_command(outcome['session_id'], outcome['config_dir'])}")
                print(f"  直したら、同じコマンドを打ち直す: shipstack run {plan.dir}")
                return 1
            resumed = f"、途中で切れて {outcome['resumes']} 回再開" if outcome["resumes"] else ""
            say(f"✓ {step['name']}（{outcome['seconds'] // 60} 分{ci_note(step, verified)}{resumed}）")
            if args.once:
                return 0
    except Stop as stop:
        notify(f"{plan.name}: 止まりました")
        say(f"■ {stop}")
        return 1
    except KeyboardInterrupt:
        current = read_active(plan)
        if not current or args.dry_run:
            say("■ 止めました")
            return 130
        append_history(plan, {"at": now(), "name": current["name"], "skill": current.get("skill"),
                              "session_id": current["session_id"], "config_dir": current.get("config_dir"),
                              "resumes": current.get("resumes", 0), "ok": False, "stopped": False, "interrupted": True,
                              "problems": ["Ctrl+C で止めました"]})
        write_active(plan, {**current, "reason": "人が Ctrl+C で止めた"})
        say(f"■ 止めました。同じコマンドを打ち直すと、{current['name']} の会話の続きから再開します"
            "（別のアカウントで打ち直してもよい。続けずに捨てるなら、手元の変更を片付けてから --fresh を付ける）")
        return 130


# ---------------------------------------------------------------- コミットメッセージ


# 下書きの置き換える場所。commit-check は、これが 1 つでも残っていれば止める。
PLACEHOLDERS = {
    "title": "<type>(<scope>): <平易な要約>",
    "why": "<解く問題を 1〜2 文で>",
    "decided": "<案を比べて決めたこと（決定、比べた案と採らなかった理由、根拠と出典）。無ければ「なし」>",
    "verified": "<実行したコマンドと結果、観察できる結果>",
    "verified_phase": "<確かめたことを 1〜3 行で（流した検査とテストの結果、観察した結果、前の push の CI とその扱い）>",
    "kept": "<残した ADR（ADR-NNNN: 表題）と仕組み（何を、どこに）>",
    "not_kept": "<残さなかった決定と理由>",
    "decisions_why": "<残す決定と対策を 1〜2 文で>",
    "conflicts": "<衝突したファイルと直し方。無ければ「なし」>",
    "condition": "<どの完了の条件を満たすための修正か>",
}
REQUIRED = {
    "phase": ("なぜ", "決めたこと", "確認したこと"),
    "decisions": ("なぜ", "残したもの", "残さなかった決定", "確認したこと"),
    "merge-main": ("取り込んだ範囲", "衝突と直し方"),
    "fix": ("満たす条件", "なぜ", "確認したこと"),
}


def block_after(lines: list[str], heading: str) -> list[str] | None:
    """コミットメッセージの項目の中身。見出しの行の次から、空行の後に箇条書きでも字下げでもない行が来るまで。"""
    try:
        start = next(i for i, line in enumerate(lines) if line.strip() == heading) + 1
    except StopIteration:
        return None
    body: list[str] = []
    blank = False
    for line in lines[start:]:
        if not line.strip():
            blank = True
            continue
        if blank and not re.match(r"^\s*-|^\s", line):
            break
        blank = False
        body.append(line.rstrip())
    return body


def skeleton_phase(plan_path: str) -> str:
    # 計画書はリポジトリの外にあって使い捨てなので、計画書が無いと読めない中身（計画書の節の写し、計画との差）は書かない。
    # 「フェーズ:」の行は、指揮役がどのフェーズのコミットかを見分けるのに使う。
    phase = PhasePlan(plan_path)
    return "\n".join([
        PLACEHOLDERS["title"], "",
        f"フェーズ: {phase.name}", "",
        "なぜ", PLACEHOLDERS["why"], "",
        "決めたこと", f"- {PLACEHOLDERS['decided']}", "",
        "確認したこと", f"- {PLACEHOLDERS['verified_phase']}",
    ]) + "\n"


def skeleton_decisions(plan_dir: str) -> str:
    plan = Plan(plan_dir)
    return "\n".join([
        PLACEHOLDERS["title"], "",
        f"手順: {plan.name}-decisions（決定と学びの記録）", "",
        "なぜ", PLACEHOLDERS["decisions_why"], "",
        "残したもの", f"- {PLACEHOLDERS['kept']}", "",
        "残さなかった決定", f"- {PLACEHOLDERS['not_kept']}", "",
        "確認したこと", f"- {PLACEHOLDERS['verified']}",
    ]) + "\n"


def skeleton_merge_main(plan_dir: str) -> str:
    plan = Plan(plan_dir)
    base = base_branch()
    commits = git("log", "--oneline", "--first-parent", f"HEAD..origin/{base}").splitlines()
    return "\n".join([
        f"Merge origin/{base} into {plan.feature}", "",
        "取り込んだ範囲", *([f"- {c}" for c in commits] or ["- なし"]), "",
        "衝突と直し方", f"- {PLACEHOLDERS['conflicts']}",
    ]) + "\n"


def skeleton_fix() -> str:
    return "\n".join([
        PLACEHOLDERS["title"], "",
        "満たす条件", f"- {PLACEHOLDERS['condition']}", "",
        "なぜ", PLACEHOLDERS["why"], "",
        "確認したこと", f"- {PLACEHOLDERS['verified']}",
    ]) + "\n"


def cmd_commit_skeleton(args) -> str:
    if args.kind == "phase":
        return skeleton_phase(args.target[0])
    if args.kind == "decisions":
        return skeleton_decisions(args.target[0])
    if args.kind == "merge-main":
        return skeleton_merge_main(args.target[0])
    return skeleton_fix()


# 計画書と要件定義書にだけある番号・記号・名前。計画書はリポジトリの外にあって使い捨てなので、コミットメッセージや
# コードに書くと、マージの後は誰も読めない（ある計画では、10 フェーズで 33 か所のコメントが
# 「README の規則 B」「要件の #28」を指していた）。
PLAN_REFERENCES = (
    re.compile(r"README の(?:規則|決めたこと|用語|フェーズ表)"),
    re.compile(r"要件の ?[#＃][0-9]"),
    re.compile(r"要件定義書|計画書"),
    re.compile(r"(?<![A-Za-z0-9])規則 ?[A-Z](?![A-Za-z0-9])"),
    re.compile(r"決めたこと ?[0-9]"),
    re.compile(r"phase-[0-9]{2}-[a-z]"),
)
# コミットメッセージにだけ見るもの（コードでは別の意味で使われうる）。
MESSAGE_PLAN_REFERENCES = (
    re.compile(r"フェーズ ?[0-9]+"),
    re.compile(r"計画(?:から|どおり|では|と違)"),
)


def plan_references(text: str, plan_name: str, message: bool) -> list[str]:
    patterns = [*PLAN_REFERENCES, re.compile(rf"(?<![a-z0-9-]){re.escape(plan_name)}-p[0-9]+(?![0-9])")]
    if message:
        patterns += MESSAGE_PLAN_REFERENCES
    return sorted({m.group(0) for pattern in patterns for m in pattern.finditer(text)})


def staged_added_lines() -> list[tuple[str, int, str]]:
    """git add した変更の、足した行（ファイル、行番号、中身）。"""
    out = git("diff", "--cached", "--no-color", "--no-ext-diff", "-U0", check=False)
    lines: list[tuple[str, int, str]] = []
    path, number = "", 0
    for line in out.splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else ""
        elif line.startswith("@@"):
            match = re.search(r"\+(\d+)", line)
            number = int(match.group(1)) if match else 0
        elif line.startswith("+") and path:
            lines.append((path, number, line[1:]))
            number += 1
    return lines


def cmd_commit_check(args) -> dict:
    lines = Path(args.message).read_text(encoding="utf-8").splitlines()
    problems: list[str] = []
    if not lines or not lines[0].strip():
        problems.append("1 行目（タイトル）が空です")
    elif args.kind == "merge-main":
        if not lines[0].startswith("Merge "):
            problems.append("main の取り込みのタイトルは「Merge origin/<既定のブランチ> into <機能ブランチ>」にします")
    elif not CONVENTIONAL.match(lines[0]):
        problems.append(f"タイトルが平易な Conventional Commits になっていません: {lines[0]}")
    if len(lines) > 1 and lines[1].strip():
        problems.append("2 行目は空行にします")
    text = "\n".join(lines)
    for value in PLACEHOLDERS.values():
        if value in text:
            problems.append(f"下書きの置き換える場所が残っています: {value}")

    order = []
    for heading in REQUIRED[args.kind]:
        index = next((i for i, line in enumerate(lines) if line.strip() == heading), None)
        if index is None:
            problems.append(f"項目「{heading}」がありません")
            continue
        order.append(index)
        if not block_after(lines, heading):
            problems.append(f"項目「{heading}」が空です")
    if order != sorted(order):
        problems.append("項目の順番が決まりと違います: " + "、".join(REQUIRED[args.kind]))

    marker_lines = [line for line in lines if line.startswith("フェーズ")]
    if args.kind == "phase":
        phase = PhasePlan(args.plan[0])
        if marker_lines != [f"フェーズ: {phase.name}"]:
            problems.append(f"「フェーズ: {phase.name}」の行がちょうど 1 行要ります（指揮役がこの行でフェーズを見分ける）")
        plan_name = phase.name.rsplit("-p", 1)[0]
        body = "\n".join(line for line in lines if not line.startswith("フェーズ:"))
        found = plan_references(body, plan_name, message=True)
        if found:
            problems.append("計画書と要件定義書にだけある番号・記号・名前があります。計画書は使い捨てで、マージの後は読めないので、"
                            "中身を言葉で書きます: " + "、".join(found))
        added = [(path, number, found) for path, number, text in staged_added_lines()
                 if (found := plan_references(text, plan_name, message=False))]
        if added:
            problems.append("git add した変更に、計画書と要件定義書にだけある番号・記号・名前があります。コメントやテストの名前は"
                            "中身を言葉で書きます: " + " / ".join(f"{path}:{number}「{'、'.join(found)}」" for path, number, found in added[:10]))
    elif args.kind == "decisions":
        plan = Plan(args.plan[0])
        expected = f"手順: {plan.name}-decisions"
        step_lines = [line for line in lines if line.startswith("手順")]
        if len(step_lines) != 1 or not step_lines[0].startswith(expected):
            problems.append(f"「{expected}（決定と学びの記録）」の行がちょうど 1 行要ります（指揮役がこの行で見分ける）")
    if args.kind != "phase" and marker_lines:
        problems.append("「フェーズ:」の行は、フェーズのコミットにだけ書きます（指揮役がフェーズを済みと取り違える）")
    return {"ok": not problems, "problems": problems}


# ---------------------------------------------------------------- 入口


def main() -> int:
    parser = argparse.ArgumentParser(prog="shipstack", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("run", help="指揮役。残りの手順を最後まで進める（リポジトリの中で実行する）")
    p.add_argument("plan_dir")
    p.add_argument("--dry-run", action="store_true", help="何も起動・変更せず、状態と次に行うことだけを示す")
    p.add_argument("--once", action="store_true", help="ワーカーを 1 つ動かして確かめたら終える")
    p.add_argument("--yes", action="store_true", help="「開始前に人がすること」が済んだものとして進める")
    p.add_argument("--retry", action="store_true", help="続けてうまくいかなかった手順を、もう一度起動する")
    p.add_argument("--fresh", action="store_true",
                   help="途中で切れたワーカーの会話を続けずに捨てる（手元の変更は片付けてから打つ）")

    p = sub.add_parser("next", help="次に行うことを決める（何も変えない）")
    p.add_argument("plan_dir")

    p = sub.add_parser("verify", help="ワーカーの後に確かめる")
    p.add_argument("plan_dir")
    p.add_argument("kind", choices=sorted(WORKERS))
    p.add_argument("name", nargs="?", help="phase のときの作業名")
    p.add_argument("--ci-timeout", type=int, default=CI_TIMEOUT_SECONDS)

    p = sub.add_parser("values", help="「プロンプトに入れる値」の表を読む")
    p.add_argument("plan_dir")
    p.add_argument("--require", nargs="+", metavar="欄", help="無ければ失敗にする欄（「{{」「}}」は付けない）")

    p = sub.add_parser("check-requirements", help="要件定義書（requirements.md）の形を確かめる（problems があれば終了コード 1）")
    p.add_argument("plan_dir")

    p = sub.add_parser("check-plan", help="計画の README と計画書の形を確かめる（problems があれば終了コード 1）")
    p.add_argument("plan_dir")

    p = sub.add_parser("preflight", help="手元のチェックアウトを確かめる（git fetch origin もする）")
    p.add_argument("plan_dir")
    p.add_argument("--require-phases-done", action="store_true", help="フェーズ表の作業名がすべて、コミットの「フェーズ:」の行にあることも確かめる")

    p = sub.add_parser("pr-create", help="機能の PR が無ければ作る（タイトルは README の「PR のタイトル」）")
    p.add_argument("plan_dir")

    p = sub.add_parser("pr-check-off", help="機能の PR の進捗の 1 行を [x] にする")
    p.add_argument("plan_dir")
    p.add_argument("marker", help="作業名、または「決定と学びの記録」")
    p.add_argument("note", help="行末に書き足すこと（コミットの短いハッシュか「なし」）")

    p = sub.add_parser("pr-body", help="仕上げた機能の PR の本文の下書きを出す")
    p.add_argument("plan_dir")

    p = sub.add_parser("pr-finalize", help="仕上げた本文を確かめ、タイトルの WIP: を外して PR に書く")
    p.add_argument("plan_dir")
    p.add_argument("body", help="仕上げた本文のファイル")

    p = sub.add_parser("ci", help="機能の PR の CI を待つ")
    p.add_argument("plan_dir")
    p.add_argument("--timeout", type=int, default=CI_TIMEOUT_SECONDS)
    p.add_argument("--interval", type=int, default=CI_POLL_SECONDS)
    p.add_argument("--appear-grace", type=int, default=CI_APPEAR_GRACE_SECONDS)

    p = sub.add_parser("previous", help="push の前に、前の push の CI を待ち、1 つ前のフェーズの「push の後の確認」を出す")
    p.add_argument("plan_dir")
    p.add_argument("name", help="このフェーズの作業名")
    p.add_argument("--timeout", type=int, default=CI_TIMEOUT_SECONDS)
    p.add_argument("--interval", type=int, default=CI_POLL_SECONDS)
    p.add_argument("--appear-grace", type=int, default=CI_APPEAR_GRACE_SECONDS)

    p = sub.add_parser("result", help="結果ファイルを書く")
    p.add_argument("plan_dir")
    p.add_argument("--name", required=True)
    p.add_argument("--skill", required=True, choices=sorted(SKILLS))
    p.add_argument("--status", required=True, choices=["done", "stopped"])
    p.add_argument("--summary", required=True)
    p.add_argument("--commit")
    p.add_argument("--branch")
    p.add_argument("--pr")
    p.add_argument("--ci", choices=["pass", "fail", "pending", "none"], help="この手順が待った CI（仕上げ）")
    p.add_argument("--previous-ci", choices=["pass", "fail", "pending", "none"], help="フェーズが push の前に確かめた、前の push の CI")
    p.add_argument("--manual-step", action="append", metavar="文")
    p.add_argument("--post-push", action="append", metavar="文",
                   help="フェーズ: push の後にしか確かめられなかった完了の条件（次のフェーズか仕上げが確かめる）")
    p.add_argument("--not-kept", action="append", metavar="文", help="決定と学びの記録: 残さなかった決定と理由（コミットしないときも PR に写すため）")
    p.add_argument("--stopped-reason")

    p = sub.add_parser("stops", help="うまくいかなかったワーカーの記録を集める")
    p.add_argument("plan_dir")

    p = sub.add_parser("session", help="要件定義と計画のスキルが、自分の会話の ID を .runs/sessions.jsonl に書く")
    p.add_argument("plan_dir")
    p.add_argument("stage", choices=sorted(USAGE_STAGES))
    p.add_argument("session_id")

    p = sub.add_parser("usage", help="計画の会話ごとの時間・モデル・エフォート・トークンを集め、手順ごとに出す")
    p.add_argument("plan_dir")
    p.add_argument("--json", action="store_true", help="表ではなく JSON で出す")

    p = sub.add_parser("commit-skeleton", help="コミットメッセージの下書きを出す")
    p.add_argument("kind", choices=sorted(REQUIRED))
    p.add_argument("target", nargs="*", help="phase: 計画書／decisions・merge-main: 計画のディレクトリ／fix: なし")

    p = sub.add_parser("commit-check", help="コミットメッセージを確かめる")
    p.add_argument("kind", choices=sorted(REQUIRED))
    p.add_argument("message", help="コミットメッセージのファイル")
    p.add_argument("--plan", nargs="+", default=[], help="phase: 計画書／decisions: 計画のディレクトリ")

    args = parser.parse_args()
    needs_target = {"phase": 1, "decisions": 1, "merge-main": 1, "fix": 0}
    if args.command == "commit-skeleton" and len(args.target) < needs_target[args.kind]:
        parser.error(f"commit-skeleton {args.kind} には対象が要ります")
    if args.command == "commit-check" and args.kind in ("phase", "decisions") and not args.plan:
        parser.error(f"commit-check {args.kind} には --plan が要ります")
    if args.command == "verify" and args.kind == "phase" and not args.name:
        parser.error("verify phase には作業名が要ります")
    handlers = {
        "next": cmd_next,
        "verify": cmd_verify,
        "values": cmd_values,
        "check-requirements": cmd_check_requirements,
        "check-plan": cmd_check_plan,
        "preflight": cmd_preflight,
        "pr-create": cmd_pr_create,
        "pr-check-off": cmd_pr_check_off,
        "pr-body": cmd_pr_body,
        "pr-finalize": cmd_pr_finalize,
        "ci": cmd_ci,
        "previous": cmd_previous,
        "result": cmd_result,
        "stops": cmd_stops,
        "session": cmd_session,
        "usage": cmd_usage,
        "commit-skeleton": cmd_commit_skeleton,
        "commit-check": cmd_commit_check,
    }
    try:
        if args.command == "run":
            return cmd_run(args)
        out = handlers[args.command](args)
    except Failure as error:
        print(json.dumps({"ok": False, "error": str(error), **error.extra}, ensure_ascii=False))
        print(str(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("止めました", file=sys.stderr)
        return 130
    if isinstance(out, str):
        sys.stdout.write(out)
        return 0
    print(json.dumps(out, ensure_ascii=False))
    return 0 if out.get("ok", True) else 1


if __name__ == "__main__":
    sys.exit(main())
