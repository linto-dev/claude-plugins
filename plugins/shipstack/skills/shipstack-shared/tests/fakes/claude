#!/usr/bin/env python3
"""試験用の claude -p。標準入力の「/<スキル> <対象>」を読み、ワーカーの役目をスキルどおりの形で決まったとおりに行う。

FAKE_CLAUDE_STOP にワーカーの名前を入れると、そのワーカーは止まって報告する。
FAKE_CLAUDE_LOG に、受け取った引数とプロンプトを 1 行ずつ書く。
FAKE_CLAUDE_DENY にコマンドを入れると、そのコマンドが権限で拒否された記録を流す。
FAKE_CLAUDE_CRASH に「名前:回数」を入れると、そのワーカーは最初のその回数だけ、手元を変えたところで API の失敗で終わる。
FAKE_CLAUDE_HANG にワーカーの名前を入れると、そのワーカーは最初の 1 回だけ、手元を変えたところで <ログ>.hang を作って止まったままになる。
FAKE_CLAUDE_RETRY に回数を入れると、始めにその回数だけ API の再試行の記録を流す。
FAKE_CLAUDE_TRANSCRIPTS があれば、本物と同じ場所（$CLAUDE_CONFIG_DIR/projects/<作業フォルダ>/<会話の ID>.jsonl）に、起動 1 回につき発言 1 件（入力 1,000・出力 100 トークン、エフォート xhigh）の会話の記録を書き足す。
--resume で起動されたら、再開のプロンプトに引いた最初の指示（「/<スキル> <対象>」）のワーカーとして続ける。

本物と同じく、始めに --settings の SessionStart のフックを動かして hook_response を流し、続けて system/init（permissionMode と、
--plugin-dir で読んだプラグイン）を流す。起動の確かめは、次の環境変数で試す。どれかが付いていると、init の後は指揮役に止められるのを
待ち、止められなければ何もせずに終わる。
FAKE_CLAUDE_NO_HOOKS: フックが動かない（--bare など）。FAKE_CLAUDE_PERMISSION_MODE: その権限のモードで始まった（auto mode が使えない）。
FAKE_CLAUDE_NO_PLUGIN: プラグインが読み込めなかった。
FAKE_CLAUDE_PLUGIN_PATH を付けると、読んだプラグインの場所をその値にする（別の場所の同じ名前のプラグインが読まれた）。
"""

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

SHIPSTACK = Path(__file__).resolve().parents[2] / "scripts" / "shipstack"
prompt = sys.stdin.read().strip()
LOG = os.environ.get("FAKE_CLAUDE_LOG")
if LOG:
    with open(LOG, "a") as f:
        f.write(json.dumps({"argv": sys.argv[1:], "prompt": prompt,
                            "watchdog": os.environ.get("CLAUDE_CODE_RETRY_WATCHDOG")}, ensure_ascii=False) + "\n")


def option(name):
    return sys.argv[sys.argv.index(name) + 1] if name in sys.argv else None


settings = json.loads(option("--settings") or "{}")
if not os.environ.get("FAKE_CLAUDE_NO_HOOKS") and settings.get("disableAllHooks") is not True:
    for group in settings.get("hooks", {}).get("SessionStart", []):
        for hook in group.get("hooks", []):
            ran = subprocess.run(hook["command"], shell=True, capture_output=True, text=True)
            print(json.dumps({"type": "system", "subtype": "hook_response", "hook_name": "SessionStart:startup",
                              "hook_event": "SessionStart", "output": ran.stdout + ran.stderr, "stdout": ran.stdout,
                              "stderr": ran.stderr, "exit_code": ran.returncode, "outcome": "success"}), flush=True)
plugins = []
if option("--plugin-dir") and not os.environ.get("FAKE_CLAUDE_NO_PLUGIN"):
    manifest = json.loads((Path(option("--plugin-dir")) / ".claude-plugin" / "plugin.json").read_text())
    plugins.append({"name": manifest["name"], "path": os.environ.get("FAKE_CLAUDE_PLUGIN_PATH") or option("--plugin-dir"),
                    "source": f"{manifest['name']}@inline", "version": manifest.get("version")})
print(json.dumps({"type": "system", "subtype": "init", "permissionMode": os.environ.get("FAKE_CLAUDE_PERMISSION_MODE")
                  or option("--permission-mode"), "plugins": plugins}), flush=True)
if any(os.environ.get(k) for k in ("FAKE_CLAUDE_NO_HOOKS", "FAKE_CLAUDE_PERMISSION_MODE", "FAKE_CLAUDE_NO_PLUGIN")):
    time.sleep(30)
    sys.exit(1)

quoted = re.search(r"「(/[^」]+)」", prompt)
skill, target = (quoted.group(1) if "--resume" in sys.argv and quoted else prompt).split(" ", 1)
skill = skill.lstrip("/").split(":")[-1]  # /<プラグイン>:<スキル>

# FAKE_CLAUDE_DENY にコマンドを入れると、そのコマンドが auto mode の分類器に拒否された記録を流す（本物の stream-json と同じ形）。
if os.environ.get("FAKE_CLAUDE_DENY"):
    print(json.dumps({"type": "assistant", "parent_tool_use_id": None, "message": {"content": [
        {"type": "tool_use", "id": "toolu_fake_denied", "name": "Bash", "input": {"command": os.environ["FAKE_CLAUDE_DENY"]}}]}}), flush=True)
    print(json.dumps({"type": "system", "subtype": "permission_denied", "tool_name": "Bash", "tool_use_id": "toolu_fake_denied",
                      "decision_reason_type": "classifier", "decision_reason": "[External System Writes]"}), flush=True)


if os.environ.get("FAKE_CLAUDE_TRANSCRIPTS"):
    argv = sys.argv[1:]
    sid = argv[argv.index("--session-id") + 1] if "--session-id" in argv else Path(argv[argv.index("--resume") + 1]).stem
    folder = Path(os.environ["CLAUDE_CONFIG_DIR"]) / "projects" / re.sub(r"[^A-Za-z0-9]", "-", os.getcwd())
    folder.mkdir(parents=True, exist_ok=True)
    stamp = __import__("datetime").datetime.now(__import__("datetime").timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")
    with (folder / f"{sid}.jsonl").open("a") as f:
        f.write(json.dumps({"type": "user", "timestamp": stamp, "message": {"content": prompt}}, ensure_ascii=False) + "\n")
        f.write(json.dumps({"type": "assistant", "timestamp": stamp, "effort": "xhigh", "message": {
            "id": f"msg-{sid}-{len(open(folder / f'{sid}.jsonl').readlines())}", "model": "claude-opus-5-5",
            "usage": {"input_tokens": 1000, "output_tokens": 100}}}) + "\n")

for attempt in range(1, int(os.environ.get("FAKE_CLAUDE_RETRY") or 0) + 1):
    print(json.dumps({"type": "system", "subtype": "api_retry", "attempt": attempt, "max_retries": 300, "retry_delay_ms": 0,
                      "error_status": None, "error": "unknown"}), flush=True)


def calls_for(name):
    """このワーカーが起動された回数（今回を含む）。"""
    path = Path(f"{LOG}.{name}.calls")
    count = int(path.read_text()) + 1 if path.exists() else 1
    path.write_text(str(count))
    return count


def interrupted(name):
    """FAKE_CLAUDE_CRASH・FAKE_CLAUDE_HANG で、手元を変えたところで切れる。"""
    count = calls_for(name)
    crash = os.environ.get("FAKE_CLAUDE_CRASH", "")
    if crash.rsplit(":", 1)[0] == name and count <= int(crash.rsplit(":", 1)[1]):
        error = "API Error: Can't reach the API server — check your internet or DNS (ENOTFOUND)"
        # 本物と同じく、再試行を使い切ったら API Error を assistant の発言として流してから終わる
        print(json.dumps({"type": "system", "subtype": "api_retry", "attempt": 1, "max_retries": 1, "retry_delay_ms": 0,
                          "error_status": None, "error": "unknown"}), flush=True)
        print(json.dumps({"type": "assistant", "parent_tool_use_id": None, "error": "unknown",
                          "message": {"content": [{"type": "text", "text": error}]}}), flush=True)
        print(json.dumps({"type": "result", "is_error": True, "result": error, "total_cost_usd": count}), flush=True)
        sys.exit(1)
    if os.environ.get("FAKE_CLAUDE_HANG") == name and count == 1:
        Path(f"{LOG}.hang").write_text(name)
        time.sleep(60)
        sys.exit(1)


def sh(*cmd):
    return subprocess.run(cmd, check=True, capture_output=True, text=True).stdout


def pp(*cmd):
    return json.loads(sh(sys.executable, "-I", str(SHIPSTACK), *cmd) or "{}")


def say(text):
    print(json.dumps({"type": "assistant", "parent_tool_use_id": None, "message": {"content": [{"type": "text", "text": text}]}}), flush=True)


def result(plan_dir, name, status="done", **extra):
    cmd = ["result", plan_dir, "--name", name, "--skill", skill, "--status", status, "--summary", "fake"]
    if status == "stopped":
        cmd += ["--stopped-reason", "試験で止めた"]
    for step in extra.get("manual", []):
        cmd += ["--manual-step", step]
    if extra.get("previous_ci"):
        cmd += ["--previous-ci", extra["previous_ci"]]
    pp(*cmd)


if skill == "implementing-plan-phase":
    text = Path(target).read_text()
    name = re.search(r"作業名\**\s*[:：]\s*\**\s*`?([a-z0-9-]+-p[0-9]+)`?", text).group(1)
    plan_dir = str(Path(target).parent)
    if os.environ.get("FAKE_CLAUDE_STOP") == name:
        say("止まります")
        result(plan_dir, name, "stopped")
    else:
        Path(f"{name}.txt").write_text(name)
        interrupted(name)
        # スキルどおり、push の前に前の push の CI を確かめる（ワーカーは CI が落ちていても書いて進める）
        previous = pp("previous", plan_dir, name, "--interval", "0", "--appear-grace", "0")
        sh("git", "add", f"{name}.txt")
        sh("git", "commit", "-q", "-m", f"feat: {name}\n\nフェーズ: {name}")
        sh("git", "push", "-q")
        pp("pr-create", plan_dir)
        pp("pr-check-off", plan_dir, name, sh("git", "rev-parse", "--short", "HEAD").strip())
        say(f"{name} を実装しました（前の push の CI: {previous['ci']}）")
        result(plan_dir, name, manual=[f"{name} の画面を確かめる"], previous_ci=previous["ci"])
elif skill == "merging-main-into-feature":
    plan = target
    name = pp("values", plan)["plan_name"] + "-merge-main"
    sh("git", "merge", "-q", "--no-ff", "origin/main", "-m", "Merge origin/main into feature")
    sh("git", "push", "-q")
    result(plan, name)
elif skill == "recording-plan-decisions":
    plan = target
    name = pp("values", plan)["plan_name"] + "-decisions"
    pp("pr-check-off", plan, "決定と学びの記録", "なし")
    result(plan, name)
elif skill == "finalizing-feature-pr":
    plan = target
    name = pp("values", plan)["plan_name"] + "-finalize"
    body = sh(sys.executable, "-I", str(SHIPSTACK), "pr-body", plan)
    body = re.sub(r"^- \[ \] (.*)$", r"- [x] \1 — 試験で確かめた", body, flags=re.M)
    body = re.sub(r"^<[^>\n]*>$\n?", "", body, flags=re.M).replace("<実行したコマンドと結果、観察できる結果>", "試験")
    path = Path(sh("git", "rev-parse", "--git-path", "pr.md").strip())
    path.write_text(body)
    out = pp("pr-finalize", plan, str(path))
    if not out.get("ok"):
        say(json.dumps(out, ensure_ascii=False))
        sys.exit(1)
    result(plan, name, manual=["マージの前: プレビューで確かめる", "マージの後: 本番で確かめる"])
# 本物と同じく、再開した会話の total_cost_usd は会話の合計（この偽物では、1 回の起動ごとに 1 ドル）
spent = int(Path(f"{LOG}.{name}.calls").read_text()) if LOG and Path(f"{LOG}.{name}.calls").exists() else 0
print(json.dumps({"type": "result", "is_error": False, "result": "done", "total_cost_usd": spent}), flush=True)
