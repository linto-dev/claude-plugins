#!/usr/bin/env python3
"""試験用の gh。機能の PR を FAKE_GH_STATE の JSON に持ち、shipstack が使う gh pr のサブコマンドだけに答える。"""

import json
import os
import sys
from pathlib import Path

state_path = Path(os.environ["FAKE_GH_STATE"])
state = json.loads(state_path.read_text()) if state_path.exists() else {"prs": [], "checks": [{"name": "ci", "bucket": "pass", "link": ""}]}
args = sys.argv[1:]


def opt(name, default=None):
    return args[args.index(name) + 1] if name in args else default


def save():
    state_path.write_text(json.dumps(state, ensure_ascii=False))


def find(ref):
    for pr in state["prs"]:
        if str(pr["number"]) == ref or (pr["head"] == ref and pr["state"] == "OPEN"):
            return pr
    return None


def fields(pr, names):
    return {k: pr.get(k) for k in names.split(",")}


if args[:2] == ["pr", "list"]:
    head = opt("--head")
    print(json.dumps([fields(p, opt("--json")) for p in state["prs"] if p["head"] == head], ensure_ascii=False))
elif args[:2] == ["pr", "view"]:
    pr = find(args[2])
    if not pr:
        print("no pull requests found", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(fields(pr, opt("--json")), ensure_ascii=False))
elif args[:2] == ["pr", "create"]:
    number = len(state["prs"]) + 1
    pr = {"number": number, "url": f"https://example.invalid/pull/{number}", "title": opt("--title"), "state": "OPEN",
          "head": opt("--head"), "body": Path(opt("--body-file")).read_text()}
    state["prs"].append(pr)
    save()
    print(pr["url"])
elif args[:2] == ["pr", "edit"]:
    pr = find(args[2])
    if "--body-file" in args:
        pr["body"] = Path(opt("--body-file")).read_text()
    if "--title" in args:
        pr["title"] = opt("--title")
    save()
elif args[:2] == ["pr", "checks"]:
    if not find(args[2]):
        print("no pull requests found", file=sys.stderr)
        sys.exit(1)
    print(json.dumps(state["checks"]))
else:
    print(f"fake gh: 知らないコマンド {args}", file=sys.stderr)
    sys.exit(2)
